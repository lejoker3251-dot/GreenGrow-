---
import Layout from '../layouts/Layout.astro';
import BotanicalHeroScene from '../components/BotanicalHeroScene.astro';
import seedProducts from '../data/seed-products.json';
const sharedProductImage = 'https://raw.githubusercontent.com/lejoker3251-dot/GreenGrow-/feature/premium-storefront-v1/images/Mamba%20Test.png.WEBP';
const products = seedProducts.map((product) => ({
  ...product,
  type: product.category,
  tag: 'Sortimentsvorschau',
  description: 'Produktdaten werden geprüft. Preis, Verfügbarkeit und weitere Sortenmerkmale sind noch nicht freigegeben.',
  image: sharedProductImage,
}));
const categories = ['Alle', 'Autoflowering', 'Feminisierte Samen', 'Reguläre Samen', 'Nicht zugeordnet'];
---
<Layout title="SEED³X – Entdecke, was wachsen kann" description="SEED³X: Saatgut, botanische Inspiration und verständliche Anzucht-Tipps für Balkon, Beet und Garten.">
  <section class="hero luxury-hero" aria-labelledby="hero-title">
    <div class="hero-content luxury-hero-content">
      <span class="eyebrow">Botanical objects · Naturally considered</span>
      <p class="hero-overline">SEED³X · GROWING, REIMAGINED</p>
      <h1 id="hero-title">Ein kleines Wunder.<br/><em>Unendliches Grün.</em></h1>
      <p class="hero-copy">Jedes Wachstum beginnt leise. Entdecke Saatgut und Inspiration für lebendige Lieblingsorte – sorgfältig ausgewählt und mit Freude zum Wachsen gedacht.</p>
      <div class="actions"><a class="button luxury-button" href="#sortiment">Kollektion entdecken <span aria-hidden="true">↗</span></a><a class="button secondary" href="#wachstumsreise">Die Geschichte dahinter</a></div>
      <div class="hero-proof"><span>01 / NATÜRLICH AUSGEWÄHLT</span><span>02 / MIT LIEBE GEZOGEN</span></div>
    </div>
    <div class="hero-art luxury-hero-art" id="hero-art" aria-label="Dreidimensionale botanische Illustration">
      <div class="hero-orbit orbit-one"></div><div class="hero-orbit orbit-two"></div>
      <div class="hero-glow"></div>
      <BotanicalHeroScene />
      <div class="hero-caption caption-top"><span>FIG. 01</span><strong>THE FIRST SPROUT</strong></div>
      <div class="hero-caption caption-bottom"><span>ROOTED IN NATURE</span><strong>GROW WITH INTENTION</strong></div>
      <span class="hero-side-note">A STUDY IN GROWTH</span>
    </div>
    <div class="hero-index"><span>BOTANICAL LUXURY</span><span>01 — 04</span></div>
  </section>
  <section class="growth-intro" id="wachstumsreise" aria-labelledby="growth-title">
    <div class="growth-heading"><span class="eyebrow">The art of becoming</span><h2 id="growth-title">Von etwas Kleinem.<br/><em>Zu etwas Lebendigem.</em></h2><p>Ein Samen trägt bereits eine ganze Möglichkeit in sich. Wir machen diese Reise sichtbar – mit botanischer Inspiration, sorgfältigen Details und Raum zum Entdecken.</p></div>
    <div class="growth-stages">
      <article class="growth-stage stage-seed"><span class="stage-number">01</span><div class="seed-object" aria-hidden="true"><i></i></div><small>DER ANFANG</small><h3>Die Möglichkeit</h3><p>Alles beginnt mit einem Samen und dem richtigen Ort.</p></article>
      <article class="growth-stage stage-root"><span class="stage-number">02</span><div class="root-object" aria-hidden="true"><i></i><i></i><i></i><i></i></div><small>UNTER DER OBERFLÄCHE</small><h3>Die Verbindung</h3><p>Wurzeln finden Halt. Wachstum bekommt Richtung.</p></article>
      <article class="growth-stage stage-leaf"><span class="stage-number">03</span><div class="leaf-object" aria-hidden="true"><i></i><i></i></div><small>DEM LICHT ENTGEGEN</small><h3>Das Entfalten</h3><p>Aus kleinen Schritten wird etwas, das weiterwächst.</p></article>
    </div>
    <div class="growth-footnote"><span>GROWING IS A JOURNEY</span><span>DESIGNED TO FEEL NATURAL</span></div>
  </section>
  <div class="trust-row luxury-trust-row" aria-label="SEED³X Grundsätze"><div class="trust-item"><span class="trust-icon">✳</span><span>Sorgfältig ausgewählt</span></div><div class="trust-item"><span class="trust-icon">◌</span><span>Für deinen Lieblingsort</span></div><div class="trust-item"><span class="trust-icon">↗</span><span>Schritt für Schritt wachsen</span></div></div>

  <section class="section" id="sortiment">
    <div class="section-heading"><div><span class="eyebrow">Finde deinen Favoriten</span><h2>Dein grüner Anfang.</h2><p>Durchsuche unseren importierten Sortimentskatalog. Alle Einträge sind noch Entwürfe; bestätigte Produktdetails und Verkaufsdaten werden schrittweise ergänzt.</p></div><span class="section-kicker">DAS SORTIMENT · 01</span></div>
    <div class="catalog-tools">
      <label class="search-box"><span aria-hidden="true">⌕</span><input id="product-search" type="search" placeholder="Produkte oder Kategorien suchen …" aria-label="Produkte oder Kategorien suchen"/></label>
      <div class="filter-row" aria-label="Produkte nach Kategorie filtern">{categories.map((category, index) => <button class="filter-button" data-filter={category} aria-pressed={index === 0 ? 'true' : 'false'}>{category === 'Alle' ? 'Alles entdecken' : category}</button>)}</div>
    </div>
    <p class="results-count" id="results-count" aria-live="polite">1.269 Produkte · Vorschau</p>
    <div class="product-grid" id="product-grid">{products.map((product) => <article class="product-card" data-category={product.type} data-id={product.id} data-name={product.name} data-type={product.type} data-image={product.image} data-status={product.status}><div class="product-image"><span class="product-tag">{product.tag}</span><img src={product.image} alt={'Universelles Produktbild für ' + product.name} loading="lazy" width="280" height="280"/></div><div class="product-info"><span class="product-type">{product.type} · Entwurf</span><h3>{product.name}</h3><p>{product.description}</p><div class="product-actions"><span class="product-note">Produktdetails folgen</span><button class="save-button" type="button" data-save={product.id} aria-pressed="false">+ Merken</button></div></div></article>)}</div>
    <p class="empty-state" id="no-results" hidden>Keine passenden Produkte gefunden. Versuche einen anderen Suchbegriff oder eine andere Kategorie.</p>
    <div class="notice">Katalogvorschau: Namen und Kategorie stammen aus der bereitgestellten Liste. Das Mamba-Bild ist ein universelles Platzhalterbild. Preise, Lagerbestand, geprüfte Sortenangaben und Bestellfunktionen sind nicht eingerichtet; alle Produkte bleiben Entwürfe.</div>
  </section>


  <section class="section guide-section" id="ratgeber"><div class="section-heading"><div><span class="eyebrow">Wissen, das mitwächst</span><h2>Der SEED³X Ratgeber.</h2><p>Finde deinen Einstieg: vom Grundlagenwissen über Samen bis zu Anbauphasen, Sorten und verantwortungsvoller Cannabis-Bildung.</p></div><a class="text-link" href="/wissen/">Alle Wissensrubriken ansehen ↗</a></div><div class="tips-grid"><article class="tip"><span class="tip-number">01 / ANBAU</span><h3>Grundkurs Cannabisanbau</h3><p>Ein strukturierter Überblick über Keimung, Wachstum, Blüte und Ernte.</p><a href="/wissen/#cannabisanbau" class="guide-link">Zum Grundkurs ↗</a></article><article class="tip"><span class="tip-number">02 / SAMEN</span><h3>Grundkurs Cannabissamen</h3><p>Samenarten, Aufbewahrung und wichtige Unterschiede verständlich erklärt.</p><a href="/wissen/#cannabissamen" class="guide-link">Samen verstehen ↗</a></article><article class="tip"><span class="tip-number">03 / ENTDECKEN</span><h3>Sorten & Cannabis-Bildung</h3><p>Orientierung zu Sorten, Merkmalen, Wirkung und verantwortungsvollem Umgang.</p><a href="/wissen/#auswahl" class="guide-link">Wissen entdecken ↗</a></article></div></section>
  <section class="cta"><div><span class="eyebrow" style="color:#d6ed9a">Kleine Samen. Große Ideen.</span><h2>Mach Platz für etwas Neues.</h2><p>SEED³X wächst gerade. Diese Vorschau zeigt die geplante Richtung – ein echter Shop folgt erst in einer späteren Entwicklungsstufe.</p></div><a class="button" href="#sortiment">Sortiment ansehen ↗</a></section>

  <section class="section split-section" id="ueber-greengrow" aria-labelledby="about-title"><div class="split-art"><img src="/products/hero-seedling.svg" alt="Junger Keimling mit kräftigen Blättern" width="440" height="360" loading="lazy"/><span class="about-location">BEDBURG · 50181<br/>NORDRHEIN-WESTFALEN</span></div><div class="split-copy"><span class="eyebrow">GreenGrow Seeds · Über uns</span><h2 id="about-title">Verwurzelt in der Region. Auf Wachstum ausgerichtet.</h2><p><strong>GreenGrow Seeds hat seinen Sitz in Bedburg (50181), im Herzen des Erftkreises in Nordrhein-Westfalen.</strong> Von hier aus widmen wir uns dem Vertrieb von hochqualitativen Samen und Vermehrungsmaterialien und verbinden traditionelles Fachwissen mit modernen Qualitätsstandards.</p><p>Unser Sortiment richtet sich an anspruchsvolle Kundinnen und Kunden, die Wert auf geprüfte Herkunft, Reinheit und Keimfähigkeit legen. Über unseren Online-Shop bieten wir einen unkomplizierten, transparenten Zugang zu unserem Angebot – von der Auswahl bis zur Lieferung.</p><p>Qualität, Verlässlichkeit und persönliche Beratung stehen bei GreenGrow Seeds im Mittelpunkt. Wir verstehen uns als kompetenter Partner für alle, die auf professionelles Vermehrungsmaterial setzen.</p><div class="benefit-list"><div class="benefit"><span class="benefit-mark">✓</span><div><strong>Qualität im Fokus</strong><span>Herkunft, Reinheit und Keimfähigkeit als zentrale Ansprüche.</span></div></div><div class="benefit"><span class="benefit-mark">✓</span><div><strong>Transparent einkaufen</strong><span>Ein klarer Weg von der Produktauswahl bis zur Lieferung.</span></div></div><div class="benefit"><span class="benefit-mark">✓</span><div><strong>Regional verwurzelt</strong><span>GreenGrow Seeds aus Bedburg im Erftkreis.</span></div></div></div></div></section>
</Layout>
<script>
  const filterButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const cards = [...document.querySelectorAll<HTMLElement>('.product-card')];
  const search = document.querySelector<HTMLInputElement>('#product-search');
  const count = document.querySelector<HTMLElement>('#results-count');
  const empty = document.querySelector<HTMLElement>('#no-results');
  let activeFilter = 'Alle';
  function updateProducts() {
    const query = (search?.value || '').trim().toLocaleLowerCase('de');
    let visible = 0;
    cards.forEach((card) => {
      const matchesCategory = activeFilter === 'Alle' || card.dataset.category === activeFilter;
      const matchesQuery = !query || (card.dataset.name || '').toLocaleLowerCase('de').includes(query) || (card.dataset.category || '').toLocaleLowerCase('de').includes(query);
      const show = matchesCategory && matchesQuery;
      card.hidden = !show;
      if (show) visible++;
    });
    if (count) count.textContent = visible + (visible === 1 ? ' Produkt' : ' Produkte');
    if (empty) empty.hidden = visible !== 0;
  }
  filterButtons.forEach((button) => button.addEventListener('click', () => {
    activeFilter = button.dataset.filter || 'Alle';
    filterButtons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
    updateProducts();
  }));
  search?.addEventListener('input', updateProducts);
  document.querySelectorAll<HTMLButtonElement>('[data-save]').forEach((button) => button.addEventListener('click', () => {
    const card = button.closest<HTMLElement>('.product-card');
    if (!card) return;
    const product = { id: card.dataset.id, name: card.dataset.name, type: card.dataset.type, image: card.dataset.image };
    let saved: typeof product[] = [];
    try { saved = JSON.parse(localStorage.getItem('greengrow-list') || '[]'); } catch {}
    const exists = saved.some((item) => item.id === product.id);
    saved = exists ? saved.filter((item) => item.id !== product.id) : [...saved, product];
    localStorage.setItem('greengrow-list', JSON.stringify(saved));
    button.setAttribute('aria-pressed', String(!exists));
    button.textContent = exists ? '+ Merken' : '✓ Gemerkt';
    const savedCount = document.querySelector('#cart-count');
    if (savedCount) savedCount.textContent = String(saved.length);
  }));
  // Progressive reveal: content remains visible if motion APIs are unavailable.
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reducedMotion && 'IntersectionObserver' in window) {
    const revealTargets = [
      ...document.querySelectorAll<HTMLElement>('main > section:not(.luxury-hero), .luxury-trust-row'),
      ...document.querySelectorAll<HTMLElement>('.growth-stage, .product-card, .feature-card, .tip')
    ];
    revealTargets.forEach((element, index) => {
      element.setAttribute('data-reveal', '');
      element.style.setProperty('--reveal-delay', (index % 4) * 80 + 'ms');
    });
    document.body.classList.add('motion-ready');
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-inview');
          revealObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -36px 0px' });
    revealTargets.forEach((element) => revealObserver.observe(element));
  }
  const growthStages = [...document.querySelectorAll<HTMLElement>('.growth-stage')];
  if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const stageObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-inview');
          stageObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.18 });
    growthStages.forEach((stage) => stageObserver.observe(stage));
  }
</script>
