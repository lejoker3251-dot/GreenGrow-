---
import Layout from '../layouts/Layout.astro';
import BrandIntro from '../components/BrandIntro.astro';
import seedProducts from '../data/seed-products.json';

const homepageCategories = [
  { name: 'Autoflowering', title: 'Autoflowering', description: 'Ein Einstieg für alle, die gezielt nach autoflowering geführten Katalogeinträgen suchen.' },
  { name: 'Feminisierte Samen', title: 'Feminisierte Samen', description: 'Die im Katalog als feminisiert gekennzeichneten Einträge auf einen Blick.' },
  { name: 'Reguläre Samen', title: 'Reguläre Samen', description: 'Entdecke die Einträge, die in der Liste als regulär geführt werden.' },
];
const homepageCategoryCounts = Object.fromEntries(homepageCategories.map((category) => [
  category.name,
  seedProducts.filter((product) => product.category === category.name).length,
]));
---
<Layout title="SEED³X – Entdecke, was wachsen kann" description="SEED³X: Saatgut, botanische Inspiration und verständliche Anzucht-Tipps für Balkon, Beet und Garten.">
  <BrandIntro />
  <section class="hero luxury-hero premium-hero botanical-title-hero" aria-labelledby="hero-title">
    <div class="hero-art luxury-hero-art botanical-title-art" id="hero-art" aria-hidden="true">
      <img src="https://raw.githubusercontent.com/lejoker3251-dot/GreenGrow-/feature/premium-storefront-v1/images/Back1.png.JPG" alt="" width="1600" height="1200" fetchpriority="high" decoding="async" />
    </div>
    <div class="hero-content luxury-hero-content botanical-title-content">
      <span class="eyebrow">Botanical objects · Naturally considered</span>
      <p class="hero-overline">SEED³X · GROWING, REIMAGINED</p>
      <h1 id="hero-title">Ein kleines Wunder.<br/><em>Unendliches Grün.</em></h1>
      <p class="hero-copy">Jedes Wachstum beginnt leise. Entdecke Saatgut und Inspiration für lebendige Lieblingsorte – sorgfältig ausgewählt und mit Freude zum Wachsen gedacht.</p>
      <div class="actions"><a class="button luxury-button" href="/shop/">Shop entdecken <span aria-hidden="true">↗</span></a><a class="button secondary" href="#wachstumsreise">Die Geschichte dahinter</a></div>
      <div class="hero-proof"><span>01 / NATÜRLICH AUSGEWÄHLT</span><span>02 / MIT LIEBE GEZOGEN</span></div>
    </div>
    <div class="hero-index"><span>BOTANICAL LUXURY</span><span>01 — 04</span></div>
  </section>
  <section class="growth-intro" id="wachstumsreise" aria-labelledby="growth-title">
    <div class="growth-heading"><span class="eyebrow">The art of becoming</span><h2 id="growth-title">Von etwas Kleinem.<br/><em>Zu etwas Lebendigem.</em></h2><p>Ein Samen trägt bereits eine ganze Möglichkeit in sich. Wir machen diese Reise sichtbar – mit botanischer Inspiration, sorgfältigen Details und Raum zum Entdecken.</p></div>
    <div class="growth-stages">
      <article class="growth-stage stage-seed"><span class="stage-number">01</span><div class="seed-object" aria-hidden="true"><i></i></div><small>DER ANFANG</small><h3>Die Möglichkeit</h3><p>Alles beginnt mit einem Samen und dem richtigen Ort.</p></article>
      <article class="growth-stage stage-root"><span class="stage-number">02</span><div class="root-object" aria-hidden="true"><i></i><i></i><i></i><i></i></div><small>UNTER DER OBERFLÄCHE</small><h3>Die Verbindung</h3><p>Wurzeln finden Halt. Wachstum bekommt Richtung.</p></article>
      <article class="growth-stage stage-leaf"><span class="stage-number">03</span><div class="leaf-object" aria-hidden="true"><i></i><i></i></div><small>DEM LICHT ENTGEGEN</small><h3>Das Entfalten</h3><p>Aus kleinen Schritten wird etwas, das weiterwächst.</p></article>
    </div>
    <div class="growth-footnote"><span>GROWING IS A JOURNEY</span><span>DESIGNED TO FEEL NATURAL</span></div>
  </section>

  <section class="section grow-doctor-section" id="grow-doctor" aria-labelledby="grow-doctor-title">
    <div class="grow-doctor-intro">
      <span class="eyebrow">Persönliche Unterstützung · Bedburg & Umgebung</span>
      <p class="grow-doctor-kicker">GROW DOCTOR</p>
      <h2 id="grow-doctor-title">Wenn es im Anbau nicht läuft, <em>helfen wir weiter.</em></h2>
      <p class="grow-doctor-lead">Manchmal braucht es einen zweiten Blick. Grow Doctor bietet volljährigen Privatpersonen Orientierung bei Fragen zum privaten Eigenanbau – persönlich, verständlich und mit Blick auf die jeweilige Situation.</p>
      <p class="grow-doctor-radius"><span aria-hidden="true">⌖</span> Bedburg und Umgebung · im Umkreis von bis zu 25 km</p>
    </div>
    <div class="grow-doctor-credential">
      <span class="grow-doctor-credential-mark" aria-hidden="true">GD</span>
      <div><span class="eyebrow">Wissen trifft Praxis</span><h3>Individuell statt nach Schema F.</h3><p>Die Beratung orientiert sich an deinen Fragen, den sichtbaren Symptomen und den Rahmenbedingungen vor Ort. Ausbildungs- und Zertifikatsangaben werden erst nach Prüfung der Nachweise veröffentlicht.</p></div>
    </div>
    <div class="grow-doctor-services">
      <article class="grow-doctor-card"><span>01 / START</span><h3>Begleitung beim ersten Grow</h3><p>Orientierung zu Standort, Ausstattung, Vorbereitung und den einzelnen Phasen – passend zu deiner Ausgangslage.</p></article>
      <article class="grow-doctor-card"><span>02 / ANALYSE</span><h3>Wenn etwas nicht stimmt</h3><p>Gemeinsame Einordnung von Verfärbungen, Schädlingsverdacht, Pilzproblemen oder auffälligem Wachstum anhand deiner Beschreibung und Fotos.</p></article>
      <article class="grow-doctor-card"><span>03 / VOR ORT</span><h3>Plan statt Rätselraten</h3><p>Wenn es sinnvoll und verfügbar ist, schauen wir uns die Situation vor Ort an und besprechen konkrete nächste Schritte samt Nachbetreuung.</p></article>
      <article class="grow-doctor-card"><span>04 / DRANBLEIBEN</span><h3>Begleitung nach Bedarf</h3><p>Regelmäßige Unterstützung nach individueller Vereinbarung – etwa mit Fotodiagnose, festen Terminen und abgestimmten Rückmeldungen.</p></article>
    </div>
    <div class="grow-doctor-process">
      <div class="grow-doctor-process-heading"><span class="eyebrow">So läuft es ab</span><h3>Ein klarer Weg zu den nächsten Schritten.</h3></div>
      <ol>
        <li><span>01</span><div><strong>Kontakt aufnehmen</strong><p>Du schilderst dein Anliegen und sendest – wenn hilfreich – ein paar aussagekräftige Fotos.</p></div></li>
        <li><span>02</span><div><strong>Erste Einschätzung</strong><p>Wir klären offene Fragen und besprechen mögliche erste Maßnahmen.</p></div></li>
        <li><span>03</span><div><strong>Termin abstimmen</strong><p>Falls nötig und verfügbar, vereinbaren wir einen Vor-Ort-Termin im Umkreis von bis zu 25 km.</p></div></li>
        <li><span>04</span><div><strong>Schritte festlegen</strong><p>Du erhältst einen verständlichen Plan, den du eigenverantwortlich umsetzen kannst.</p></div></li>
        <li><span>05</span><div><strong>Nachfassen</strong><p>Wir besprechen den Verlauf und klären, ob weitere Unterstützung sinnvoll ist.</p></div></li>
      </ol>
    </div>
    <aside class="grow-doctor-notice"><strong>Wichtig zu wissen</strong><p>Das Angebot richtet sich ausschließlich an Erwachsene und steht unter dem Vorbehalt der jeweils geltenden gesetzlichen Vorgaben. Grow Doctor bietet Orientierung und praktische Beratung, aber keine Rechts- oder Medizinberatung. Pflanzen, Pflanzenteile oder Ernte werden im Rahmen dieses Services nicht übernommen; ebenso werden darüber keine Vermehrungsmaterialien beschafft oder verkauft. Die Verantwortung für den eigenen Anbau und die Umsetzung aller Maßnahmen bleibt bei dir.</p></aside>
    <div class="grow-doctor-contact">
      <div><span class="eyebrow">Persönlich ins Gespräch kommen</span><h3>Erzähl uns, wo du gerade feststeckst.</h3><p>Kontaktiere uns für eine erste Abstimmung. Erreichbarkeit, mögliche Termine und ein etwaiger Vor-Ort-Besuch werden individuell vereinbart.</p></div>
      <div class="grow-doctor-contact-actions"><a class="button grow-doctor-button" href="/kontakt/">Kontakt aufnehmen <span aria-hidden="true">↗</span></a><span>Telefon: [Telefon ergänzen]</span><span>E-Mail: [E-Mail ergänzen]</span><span>Zeiten: [Zeiten ergänzen]</span></div>
    </div>
  </section>

  <div class="trust-row luxury-trust-row" aria-label="SEED³X Grundsätze"><div class="trust-item"><span class="trust-icon">✳</span><span>Sorgfältig ausgewählt</span></div><div class="trust-item"><span class="trust-icon">◌</span><span>Für deinen Lieblingsort</span></div><div class="trust-item"><span class="trust-icon">↗</span><span>Schritt für Schritt wachsen</span></div></div>

  <section class="section seed-category-visual" aria-labelledby="seed-category-visual-title">
    <div class="seed-category-visual-heading">
      <span class="eyebrow">Botanical selection</span>
      <h2 id="seed-category-visual-title">Entdecke die <em>Vielfalt.</em></h2>
      <p>Ein erster visueller Überblick über unsere Kategorien – ruhig kuratiert und im Stil von SEED³X.</p>
    </div>
    <div class="seed-category-visual-art">
      <img src="https://raw.githubusercontent.com/lejoker3251-dot/GreenGrow-/feature/premium-storefront-v1/images/Back%202%20Seed.png.jpg" alt="Botanisches Kategorienmotiv für die SEED³X Homepage" width="1600" height="1000" loading="lazy" decoding="async" />
    </div>
    <div class="seed-category-visual-footer"><span>THE BOTANICAL EDIT</span><a href="/shop/">Alle Kategorien im Shop entdecken <span aria-hidden="true">↗</span></a></div>
  </section>

  <section class="section shop-teaser" aria-labelledby="shop-teaser-title">
    <div class="shop-teaser-art"><img src="/images/seedx-banner.png.PNG" alt="SEED³X – The Botanical Edit" width="1011" height="335" loading="lazy" decoding="async" /></div>
    <div class="shop-teaser-copy"><span class="eyebrow">The collection</span><h2 id="shop-teaser-title">Das Sortiment.<br/><em>In Ruhe entdecken.</em></h2><p>Unser vollständiger Katalog liegt bewusst auf einer eigenen Shop-Seite. Dort kannst du gezielt suchen, nach Samenkategorie filtern, sortieren und Favoriten merken – ohne dass die Startseite überladen wirkt.</p><a class="button luxury-button" href="/shop/">Zum gesamten Sortiment <span aria-hidden="true">↗</span></a><span class="shop-teaser-note">{seedProducts.length.toLocaleString('de-DE')} Katalogeinträge · Vorschau, noch keine Bestellfunktion</span></div>
  </section><section class="section home-category-section" aria-labelledby="home-category-title">
    <div class="section-heading">
      <div><span class="eyebrow">Dein Einstieg ins Sortiment</span><h2 id="home-category-title">Finde deinen Saatentyp.</h2><p>Die Kategorien orientieren sich an den vorhandenen Katalogdaten. Die Anzahl zeigt Einträge in der Vorschau – keine geprüfte Verfügbarkeit oder Verkaufsfreigabe.</p></div>
      <a class="text-link" href="/shop/">Alle Katalogeinträge ansehen ↗</a>
    </div>
    <div class="home-category-grid">
      {homepageCategories.map((category, index) => (
        <article class="home-category-card">
          <span class="home-category-number">0{index + 1} / SAATENTYP</span>
          <h3>{category.title}</h3>
          <p>{category.description}</p>
          <div class="home-category-footer">
            <span>{homepageCategoryCounts[category.name].toLocaleString('de-DE')} Katalogeinträge</span>
            <a href={'/shop/?typ=' + encodeURIComponent(category.name) + '#sortiment'}>Kategorie ansehen <span aria-hidden="true">↗</span></a>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="section guide-section" id="ratgeber"><div class="section-heading"><div><span class="eyebrow">Wissen, das mitwächst</span><h2>Der SEED³X Ratgeber.</h2><p>Finde deinen Einstieg: vom Grundlagenwissen über Samen bis zu Anbauphasen, Sorten und verantwortungsvoller Cannabis-Bildung.</p></div><a class="text-link" href="/wissen/">Alle Wissensrubriken ansehen ↗</a></div><div class="tips-grid"><article class="tip"><span class="tip-number">01 / ANBAU</span><h3>Grundkurs Cannabisanbau</h3><p>Ein strukturierter Überblick über Keimung, Wachstum, Blüte und Ernte.</p><a href="/wissen/#cannabisanbau" class="guide-link">Zum Grundkurs ↗</a></article><article class="tip"><span class="tip-number">02 / SAMEN</span><h3>Grundkurs Cannabissamen</h3><p>Samenarten, Aufbewahrung und wichtige Unterschiede verständlich erklärt.</p><a href="/wissen/#cannabissamen" class="guide-link">Samen verstehen ↗</a></article><article class="tip"><span class="tip-number">03 / ENTDECKEN</span><h3>Sorten & Cannabis-Bildung</h3><p>Orientierung zu Sorten, Merkmalen, Wirkung und verantwortungsvollem Umgang.</p><a href="/wissen/#auswahl" class="guide-link">Wissen entdecken ↗</a></article></div></section>
  <section class="cta"><div><span class="eyebrow" style="color:#d6ed9a">Kleine Samen. Große Ideen.</span><h2>Mach Platz für etwas Neues.</h2><p>SEED³X wächst gerade. Diese Vorschau zeigt die geplante Richtung – ein echter Shop folgt erst in einer späteren Entwicklungsstufe.</p></div><a class="button" href="/shop/">Sortiment entdecken ↗</a></section>

  <section class="section split-section" id="ueber-greengrow" aria-labelledby="about-title"><div class="split-art"><img src="/products/hero-seedling.svg" alt="Junger Keimling mit kräftigen Blättern" width="440" height="360" loading="lazy"/><span class="about-location">BEDBURG · 50181<br/>NORDRHEIN-WESTFALEN</span></div><div class="split-copy"><span class="eyebrow">GreenGrow Seeds · Über uns</span><h2 id="about-title">Verwurzelt in der Region. Auf Wachstum ausgerichtet.</h2><p><strong>GreenGrow Seeds hat seinen Sitz in Bedburg (50181), im Herzen des Erftkreises in Nordrhein-Westfalen.</strong> Von hier aus widmen wir uns dem Vertrieb von hochqualitativen Samen und Vermehrungsmaterialien und verbinden traditionelles Fachwissen mit modernen Qualitätsstandards.</p><p>Unser Sortiment richtet sich an anspruchsvolle Kundinnen und Kunden, die Wert auf geprüfte Herkunft, Reinheit und Keimfähigkeit legen. Über unseren Online-Shop bieten wir einen unkomplizierten, transparenten Zugang zu unserem Angebot – von der Auswahl bis zur Lieferung.</p><p>Qualität, Verlässlichkeit und persönliche Beratung stehen bei GreenGrow Seeds im Mittelpunkt. Wir verstehen uns als kompetenter Partner für alle, die auf professionelles Vermehrungsmaterial setzen.</p><div class="benefit-list"><div class="benefit"><span class="benefit-mark">✓</span><div><strong>Qualität im Fokus</strong><span>Herkunft, Reinheit und Keimfähigkeit als zentrale Ansprüche.</span></div></div><div class="benefit"><span class="benefit-mark">✓</span><div><strong>Transparent einkaufen</strong><span>Ein klarer Weg von der Produktauswahl bis zur Lieferung.</span></div></div><div class="benefit"><span class="benefit-mark">✓</span><div><strong>Regional verwurzelt</strong><span>GreenGrow Seeds aus Bedburg im Erftkreis.</span></div></div></div></div></section>
</Layout>
<script>
  // Progressive reveal: content remains visible if motion APIs are unavailable.
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reducedMotion && 'IntersectionObserver' in window) {
    const revealTargets = [
      ...document.querySelectorAll<HTMLElement>('main > section:not(.luxury-hero), .luxury-trust-row'),
      ...document.querySelectorAll<HTMLElement>('.growth-stage, .product-card, .feature-card, .tip')
    ];
    revealTargets.forEach((element, index) => {
      element.setAttribute('data-reveal', '');
      element.style.setProperty('--reveal-delay', (index % 4) * 80 + 'ms');
    });
    document.body.classList.add('motion-ready');
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-inview');
          revealObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -36px 0px' });
    revealTargets.forEach((element) => revealObserver.observe(element));
  }
</script>
<style>
  .home-category-section{padding-top:clamp(2.5rem,5vw,4.5rem);padding-bottom:clamp(2.5rem,5vw,4.5rem)}
  .home-category-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin-top:1.5rem}
  .home-category-card{display:flex;flex-direction:column;min-width:0;padding:clamp(1.15rem,2vw,1.7rem);border:1px solid var(--line);border-radius:18px;background:#fffdf8;box-shadow:0 10px 28px #20362a08}
  .home-category-number{color:#718069;font-size:.65rem;letter-spacing:.14em;font-weight:800}
  .home-category-card h3{margin:1rem 0 .55rem;font-family:Georgia,"Times New Roman",serif;font-size:clamp(1.45rem,2.2vw,2rem);font-weight:500;letter-spacing:-.04em}
  .home-category-card p{flex:1;color:var(--muted);font-size:.9rem;line-height:1.75}
  .home-category-footer{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.75rem;margin-top:1.1rem;padding-top:1rem;border-top:1px solid var(--line)}
  .home-category-footer>span{font-size:.78rem;color:var(--muted)}
  .home-category-footer a{display:inline-flex;align-items:center;gap:.45rem;color:var(--green);font-size:.82rem;font-weight:750;text-decoration:none}
  .home-category-footer a:hover{color:var(--green-2)}
  .home-category-footer a:focus-visible{outline:3px solid #8ba96b;outline-offset:3px}
  @media(max-width:760px){.home-category-grid{grid-template-columns:1fr}.home-category-card{padding:1.2rem}}

  /* Full-bleed photographic botanical hero: the plant is the main visual, with typography layered above it. */
  .premium-hero.luxury-hero.botanical-title-hero{
    position:relative;isolation:isolate;display:flex;align-items:center;min-height:clamp(680px,78vw,900px);
    overflow:hidden;padding:clamp(4rem,8vw,7rem) clamp(1.5rem,8vw,8rem);
    background:#102b1d;color:#fffdf7;border-bottom:1px solid #c5ad76;
  }
  .botanical-title-hero:before{
    content:"";position:absolute;z-index:1;inset:0;pointer-events:none;
    background:linear-gradient(90deg,rgba(8,29,19,.88) 0%,rgba(8,29,19,.66) 38%,rgba(8,29,19,.22) 70%,rgba(8,29,19,.12) 100%),
      linear-gradient(0deg,rgba(8,29,19,.42) 0%,transparent 30%,rgba(8,29,19,.12) 100%);
  }
  .botanical-title-hero .botanical-title-content{position:relative;z-index:2;width:min(68%,760px);max-width:760px;padding:2rem 0}
  .botanical-title-hero .eyebrow{color:#e2cf9c}
  .botanical-title-hero .hero-overline{color:#e4d4a7;letter-spacing:.18em;font-size:.72rem;font-weight:800}
  .botanical-title-hero h1{max-width:780px;margin:.9rem 0 1.35rem;color:#fffdf7;font-size:clamp(3.5rem,7.2vw,7.2rem);line-height:.93;letter-spacing:-.067em;text-shadow:0 3px 28px #06190f66}
  .botanical-title-hero h1 em{color:#d6c5e9;font-weight:500}
  .botanical-title-hero .hero-copy{max-width:36rem;color:#f0f0e6;font-size:clamp(1rem,1.3vw,1.15rem);line-height:1.8;text-shadow:0 2px 14px #06190f88}
  .botanical-title-hero .hero-art.botanical-title-art{position:absolute;z-index:0;inset:0;width:100%;height:100%;min-height:0;overflow:hidden;border:0;border-radius:0;background:#102b1d;box-shadow:none;pointer-events:none}
  .botanical-title-hero .botanical-title-art:after{display:none}
  .botanical-title-hero .botanical-title-art img{display:block;width:100%;height:100%;object-fit:cover;object-position:center 46%;filter:saturate(1.08) contrast(1.04)}
  .botanical-title-hero .hero-index{left:clamp(1.5rem,8vw,8rem);right:clamp(1.5rem,8vw,8rem);bottom:1.1rem;color:#f0e6cb;border-color:#d7c58b66}
  .botanical-title-hero .button.secondary{color:#fffdf7;border-color:#e6dec8aa;background:#ffffff0d}
  .botanical-title-hero .button.secondary:hover{background:#ffffff20;border-color:#d8c49a}
  /* Keep the uploaded photograph full-bleed and enforce readable ivory typography. */
  .premium-hero.luxury-hero.botanical-title-hero{
    display:flex!important;grid-template-columns:none!important;align-items:center!important;
    min-height:clamp(700px,82vw,900px)!important;height:auto!important;
    padding:clamp(4rem,7vw,6.5rem) clamp(1.25rem,7vw,7rem) 5rem!important;
    background:#102b1d!important;color:#fffdf7!important;
  }
  .premium-hero.luxury-hero.botanical-title-hero .hero-art.botanical-title-art{
    position:absolute!important;inset:0!important;display:block!important;
    width:100%!important;height:100%!important;min-height:0!important;max-height:none!important;margin:0!important;
  }
  .premium-hero.luxury-hero.botanical-title-hero .hero-art.botanical-title-art img{
    position:absolute!important;inset:0!important;display:block!important;width:100%!important;height:100%!important;
    max-height:none!important;object-fit:cover!important;object-position:center 45%!important;
  }
  .premium-hero.luxury-hero.botanical-title-hero .botanical-title-content{width:min(72%,760px)!important;max-width:760px!important;color:#fffdf7!important}
  .premium-hero.luxury-hero.botanical-title-hero .eyebrow,
  .premium-hero.luxury-hero.botanical-title-hero .hero-overline,
  .premium-hero.luxury-hero.botanical-title-hero .hero-proof{color:#f0e6cb!important}
  .premium-hero.luxury-hero.botanical-title-hero h1{color:#fffdf7!important;text-shadow:0 3px 28px #06190fcc!important}
  .premium-hero.luxury-hero.botanical-title-hero h1 em{color:#d8cbea!important}
  .premium-hero.luxury-hero.botanical-title-hero .hero-copy{color:#fffdf7!important;text-shadow:0 2px 16px #06190fcc!important}
  .premium-hero.luxury-hero.botanical-title-hero .hero-index{color:#f0e6cb!important;border-color:#d7c58b88!important}
  @media(max-width:900px){
    .premium-hero.luxury-hero.botanical-title-hero{min-height:760px!important;padding:4rem 2rem 5rem!important}
    .botanical-title-hero:before{background:linear-gradient(90deg,rgba(8,29,19,.8),rgba(8,29,19,.34)),linear-gradient(0deg,rgba(8,29,19,.5),transparent 55%)}
    .botanical-title-hero .botanical-title-content{width:min(82%,680px)}
    .botanical-title-hero .botanical-title-art img{object-position:58% center}
    .botanical-title-hero h1{font-size:clamp(3.4rem,8.5vw,6rem)}
  }
  @media(max-width:640px){
