---
import Layout from '../../layouts/Layout.astro';
import seedProducts from '../../data/seed-products.json';

export function getStaticPaths() {
  return seedProducts.map((product) => ({
    params: { id: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const image = 'https://raw.githubusercontent.com/lejoker3251-dot/GreenGrow-/feature/premium-storefront-v1/images/White%201.png.JPG';
const title = product.name + ' – SEED³X Sortimentsvorschau';
---
<Layout title={title} description={'Entwurfsansicht für ' + product.name + '. Produktdaten werden noch geprüft; keine Bestellung möglich.'}>
  <section class="page-hero product-detail-hero">
    <span class="eyebrow">SEED³X · SORTIMENTSVORSCHAU</span>
    <h1>{product.name}</h1>
    <p>Ein Eintrag aus dem importierten Sortimentskatalog. Die Angaben auf dieser Seite sind noch in Prüfung und stellen kein kaufbares Angebot dar.</p>
  </section>
  <section class="section product-detail seed-detail">
    <div class="seed-detail-image">
      <img src={image} alt={'Einheitliches Produktbild für ' + product.name} width="640" height="640" loading="eager" />
      <span class="product-tag">Sortimentsvorschau</span>
    </div>
    <div class="seed-detail-copy">
      <span class="eyebrow">Produkt-ID · {product.id}</span>
      <h2>{product.name}</h2>
      <dl class="seed-facts">
        <div><dt>Katalogkategorie</dt><dd>{product.category}</dd></div>
        <div><dt>Quelltyp</dt><dd>{product.details}</dd></div>
        <div><dt>Prüfstatus</dt><dd><span class="draft-status">Entwurf · nicht freigegeben</span></dd></div>
      </dl>
      <div class="product-description-block"><h3>Produktbeschreibung</h3><p>{product.description || 'Für diesen Eintrag liegt noch keine individuelle Beschreibung vor.'}</p><p class="description-source-note">Quelle: bereitgestellter Produktkatalog. Die Angaben sind noch nicht unabhängig verifiziert.</p></div><p>Preise und Verfügbarkeit werden erst ergänzt, wenn sie geprüft und freigegeben wurden.</p>
      <div class="notice">Diese Seite ist eine unverbindliche Katalogvorschau. Es gibt keine Kauf- oder Bestellfunktion.</div>
      <div class="actions">
        <a class="button" href="/shop/">Zurück zum Sortiment ↗</a>
        <a class="button secondary" href="/shopping-cart/">Merkliste ansehen</a>
      </div>
    </div>
  </section>
</Layout>
<style>
  .seed-detail{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(2rem,5vw,5rem);align-items:start}
  .seed-detail-image{position:relative;overflow:hidden;border:1px solid #e0e3d7;border-radius:24px;background:linear-gradient(145deg,#f4f3e9,#e9eddf)}
  .seed-detail-image img{display:block;width:100%;height:auto;mix-blend-mode:multiply}
  .seed-detail-image .product-tag{position:absolute;top:1rem;left:1rem}
  .seed-detail-copy h2{margin:.6rem 0 1.3rem}
  .product-description-block{margin:1.5rem 0;padding:1.25rem;border:1px solid #e0e3d7;border-radius:16px;background:#fffefa}
  .product-description-block h3{margin:0 0 .65rem;font-size:1.15rem}
  .product-description-block p{line-height:1.75}
  .description-source-note{color:#687269;font-size:.82rem}
  .seed-facts{margin:1.5rem 0;border-top:1px solid #e3e6dc}
  .seed-facts div{display:grid;grid-template-columns:minmax(8rem,.8fr) minmax(0,1.2fr);gap:1rem;padding:.9rem 0;border-bottom:1px solid #e3e6dc}
  .seed-facts dt{color:#647363;font-size:.9rem}
  .seed-facts dd{margin:0;font-weight:600;overflow-wrap:anywhere}
  .draft-status{display:inline-block;padding:.25rem .55rem;border-radius:999px;background:#f1e8cf;color:#624d1d;font-size:.8rem}
  @media(max-width:760px){.seed-detail{grid-template-columns:1fr}.seed-detail-image{max-width:560px}.seed-facts div{grid-template-columns:1fr;gap:.25rem}}
</style>
