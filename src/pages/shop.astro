---
import Layout from '../layouts/Layout.astro';
import seedProducts from '../data/seed-products.json';
const products = seedProducts.map((sourceProduct) => {
  const product = {
    ...sourceProduct,
    packVariants: sourceProduct.packVariants,
    type: sourceProduct.category,
    tag: 'Sortimentsvorschau',
    description: sourceProduct.description || 'Eine individuelle Beschreibung liegt für diesen Katalogeintrag noch nicht vor.',
    image: sourceProduct.image || '/images/products/seed-archive.png',
  };
  return product;
});
const categoryDefinitions = [
  { name: 'Feminisierte Samen', title: 'Feminisierte Samen', description: 'Katalogeinträge, die in der Quelle als Feminized geführt werden.', kind: 'filter' },
  { name: 'Reguläre Samen', title: 'Reguläre Samen', description: 'Katalogeinträge, die in der Quelle als Regular geführt werden.', kind: 'filter' },
  { name: 'Autoflowering', title: 'Automatic', description: 'Katalogeinträge, die in der Quelle als Automatic Flowering geführt werden.', kind: 'filter' },
  { name: 'Outdoor', title: 'Outdoor', description: 'Eine eigene Übersicht für Sorten, deren Eignung für den Außenbereich anhand der jeweiligen Züchterangaben geprüft wurde.', kind: 'planned' },
  { name: 'Für Anfänger', title: 'Für Anfänger', description: 'Eine kuratierte Orientierungshilfe mit Fokus auf nachvollziehbar dokumentierte, vergleichsweise robuste Sorteneigenschaften.', kind: 'planned' },
];
const categories = ['Alle', ...categoryDefinitions.filter((category) => category.kind === 'filter').map((category) => category.name)];
const categoryCounts = Object.fromEntries(categoryDefinitions.map((category) => [
  category.name,
  products.filter((product) => product.category === category.name).length,
]));
const catalogCount = products.length;
---
<Layout title="Shop entdecken – SEED³X" description="Der SEED³X Katalog mit Suche, Saatentypen, Filtern, Sortierung und Preisen für vier Packungsgrößen.">
  <section class="page-hero shop-page-hero">
    <span class="eyebrow">SEED³X · THE COLLECTION</span>
    <h1>Der Shop.<br/><em>Alles an einem Ort.</em></h1>
    <p>Finde den passenden Einstieg über den Saatentyp oder durchsuche den gesamten Katalog. Für alle Produkte sind Preise für 1, 3, 5 und 10 Samen hinterlegt.</p>
    <div class="shop-hero-meta"><span>{catalogCount.toLocaleString('de-DE')} KATALOGEINTRÄGE</span><span>BOTANICAL COLLECTION</span></div>
  </section>
  <section class="section category-entry-section" aria-labelledby="category-entry-title">
    <div class="section-heading">
      <div><span class="eyebrow">Einfacher Einstieg</span><h2 id="category-entry-title">Finde deinen Samentyp.</h2><p>Fünf klare Einstiege: drei Saatentypen aus dem vorhandenen Katalog sowie die Rubriken Outdoor und Für Anfänger. Diese beiden Rubriken bleiben in Vorbereitung, bis passende Produktangaben verlässlich geprüft sind.</p></div>
      <span class="section-kicker">KATEGORIEN · 05</span>
    </div>
    <div class="category-entry-grid">
      {categoryDefinitions.map((category, index) => (
        <article class="category-entry-card">
          <span class="category-entry-index">0{index + 1} / KATEGORIE</span>
          <h3>{category.title}</h3>
          <p>{category.description}</p>
          <div class="category-entry-footer">
            {category.kind === 'filter' ? (
              <>
                <span>{categoryCounts[category.name].toLocaleString('de-DE')} Katalogeinträge</span>
                <button type="button" class="category-entry-link" data-filter={category.name} data-category-entry="true" aria-pressed="false">Kategorie ansehen <span aria-hidden="true">↘</span></button>
              </>
            ) : (
              <>
                <span class="rubric-status">Auswahl in Vorbereitung</span>
                <a class="category-entry-link" href="#sortiment">Zum Katalog <span aria-hidden="true">↗</span></a>
              </>
            )}
          </div>
        </article>
      ))}
    </div>
    <div class="all-catalog-entry">
      <div><strong>Du möchtest alles durchsehen?</strong><span>Alle {catalogCount.toLocaleString('de-DE')} Katalogeinträge in einer Liste.</span></div>
      <button type="button" class="button" data-filter="Alle" data-category-entry="true" aria-pressed="false">Gesamtes Sortiment ansehen ↘</button>
    </div>
    <p class="rubric-disclaimer">Hinweis: Outdoor und Für Anfänger sind als Rubriken sichtbar, aber noch nicht mit Produkten befüllt. Wir ordnen keine Sorten allein anhand des Namens oder unbestätigter Annahmen zu.</p>
  </section>
  <section class="section cali-editorial-section" aria-labelledby="cali-editorial-title">
    <div class="section-heading">
      <div><span class="eyebrow">Genetik · Herkunft · Auswahl</span><h2 id="cali-editorial-title">Besondere Genetiken.<br/><em>Bewusst ausgewählt.</em></h2><p>Ein redaktioneller Überblick zu Cali-Genetiken, Qualität und Orientierung – ohne ungeprüfte Herkunfts- oder Ernteversprechen.</p></div>
      <span class="section-kicker">SEED³X · EDITION 02</span>
    </div>
    <div class="cali-editorial-grid">
      <article class="cali-editorial-card">
        <span class="category-entry-index">01 / GENETIK</span>
        <h3>California Genetics</h3>
        <p>Kalifornien hat die internationale Cannabis-Kultur mit bekannten Sortennamen wie Runtz, Zkittlez, Gelato, Lemon Cherry und OG Kush geprägt. Ein Sortenname allein bestätigt jedoch weder Herkunft noch genetische Identität.</p>
        <a class="cali-editorial-link" href="/wissen/">Wissenswelt öffnen <span aria-hidden="true">↗</span></a>
      </article>
      <article class="cali-editorial-card">
        <span class="category-entry-index">02 / HERKUNFT</span>
        <h3>Original Cali</h3>
        <p>Bei Herkunftsangaben zählen nachvollziehbare Quellen und klare Züchterinformationen. Ohne verifizierbare Belege kennzeichnen wir eine Herkunft nicht als bestätigt.</p>
        <a class="cali-editorial-link" href="/wissen/samenarten-vergleich/">Samenarten vergleichen <span aria-hidden="true">↗</span></a>
      </article>
      <article class="cali-editorial-card">
        <span class="category-entry-index">03 / TRANSPARENZ</span>
        <h3>Nachvollziehbare Auswahl</h3>
        <p>Ein Sortenname ist kein Qualitätsnachweis. Produktmerkmale und Herkunft werden erst dann als bestätigt dargestellt, wenn sie anhand verlässlicher Quellen geprüft wurden.</p>
        <a class="cali-editorial-link" href="/wissen/indica-vs-sativa/">Sortenmerkmale verstehen <span aria-hidden="true">↗</span></a>
      </article>
      <article class="cali-editorial-card">
        <span class="category-entry-index">04 / ORIENTIERUNG</span>
        <h3>Für Einsteiger</h3>
        <p>Du möchtest erst einmal die Grundlagen sortieren? Nutze den Seed Finder als geführten Einstieg. Er ersetzt keine Prüfung konkreter Produktangaben.</p>
        <a class="cali-editorial-link" href="/seed-finder/">Zum Seed Finder <span aria-hidden="true">↗</span></a>
      </article>
    </div>
  </section>
  <section class="section shop-catalog" id="sortiment">
    <div class="section-heading"><div><span class="eyebrow">Finde deinen Favoriten</span><h2>Das gesamte Sortiment.</h2><p>Suche nach Namen, filtere nach Saatentyp und sortiere die vorhandenen Katalogeinträge. Produktdaten und Verkaufsfreigaben werden nicht vorweggenommen.</p></div><span class="section-kicker">DAS SORTIMENT · 01</span></div>
    <div class="catalog-tools">
      <label class="search-box"><span aria-hidden="true">⌕</span><input id="product-search" type="search" placeholder="Produkte oder Kategorien suchen …" aria-label="Produkte oder Kategorien suchen"/></label>
      <div class="filter-row" aria-label="Produkte nach Saatentyp filtern">{categories.map((category, index) => <button class="filter-button" data-filter={category} aria-pressed={index === 0 ? 'true' : 'false'}>{category === 'Alle' ? 'Alle Saatentypen' : category}</button>)}</div>
      <div class="catalog-sort"><label for="product-sort">Sortieren</label><select id="product-sort" aria-label="Produkte sortieren"><option value="source">Originale Listenreihenfolge</option><option value="name-asc">Name: A–Z</option><option value="name-desc">Name: Z–A</option><option value="category">Kategorie</option></select></div>
    </div>
    <p class="results-count" id="results-count" aria-live="polite">{catalogCount.toLocaleString('de-DE')} Katalogeinträge</p>
    <div class="product-grid" id="product-grid">{products.slice(0, 24).map((product) => <article class="product-card" data-category={product.type} data-id={product.id} data-name={product.name} data-type={product.type} data-image={product.image} data-status={product.status}><a class="product-image product-image-link" href={'/product/' + product.id + '/'} aria-label={`Details zu ${product.name} öffnen`}><span class="product-tag">{product.tag}</span><img src={product.image} alt="Symbolbild aus dem SEED³X Bildarchiv; kein verifiziertes Einzelproduktfoto" loading="lazy" decoding="async" width="280" height="280"/></a><div class="product-info"><span class="product-type">{product.type} </span><h3><a class="product-title-link" href={'/product/' + product.id + '/'}>{product.name}</a></h3><p>Individuelle Sortenangaben werden vor einer Veröffentlichung anhand verlässlicher Züchter- oder Herstellerquellen geprüft.</p>{product.packVariants?.length > 0 && <div class="pack-price-preview" aria-label="Preisvorschau je Packungsgröße"><span class="pack-price-heading">Preise je Packungsgröße</span><div class="pack-price-grid">{product.packVariants.map((variant) => <div class="pack-price-option"><span>{variant.quantity} Samen</span><strong>{variant.priceEUR.toLocaleString('de-DE', { style: 'currency', currency: 'EUR' })}</strong></div>)}</div></div>}<span class="product-note">Katalogname und Kategorie · Sortenmerkmale noch nicht verifiziert</span><div class="product-actions"><a class="text-link product-detail-link" href={'/product/' + product.id + '/'}>Details ansehen ↗</a><button class="save-button" type="button" data-save={product.id} aria-pressed="false">+ Merken</button></div></div></article>)}</div>
    <button class="button catalog-load-more" id="catalog-load-more" type="button">Mehr anzeigen</button>
    <script type="application/json" id="catalog-data" set:html={JSON.stringify(products).replace(/</g, '\\u003c')}></script>
    <p class="empty-state" id="no-results" hidden>Keine passenden Produkte gefunden. Versuche einen anderen Suchbegriff oder eine andere Kategorie.</p>
    <div class="notice">Preisübersicht: Für alle 1.269 Katalogeinträge sind Preise für 1, 3, 5 und 10 Samen hinterlegt. Die Preisstaffeln können bei Bedarf angepasst werden. Produktmerkmale und Lagerbestand werden separat geprüft; Bestellungen und Zahlungen bleiben deaktiviert.</div>
  </section>
</Layout>
<script>
  type Product = { id: string; name: string; category: string; type?: string; image?: string; status?: string; description?: string; packVariants?: { quantity: number; priceEUR: number }[] };
  const catalogData = document.querySelector<HTMLScriptElement>('#catalog-data');
  const allProducts = (catalogData?.textContent ? JSON.parse(catalogData.textContent) : []) as Product[];
  const filterButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const search = document.querySelector<HTMLInputElement>('#product-search');
  const count = document.querySelector<HTMLElement>('#results-count');
  const empty = document.querySelector<HTMLElement>('#no-results');
  const sortSelect = document.querySelector<HTMLSelectElement>('#product-sort');
  const grid = document.querySelector<HTMLElement>('#product-grid');
  const loadMore = document.querySelector<HTMLButtonElement>('#catalog-load-more');
  const pageSize = 24;
  const requestedFilter = new URLSearchParams(window.location.search).get('typ');
  let activeFilter = filterButtons.some((button) => button.dataset.filter === requestedFilter) ? (requestedFilter || 'Alle') : 'Alle';
  let shownCount = pageSize;
  let filteredProducts: Product[] = [];

  const escapeHtml = (value: unknown) => String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char] || char);
  const formatPrice = (value: number) => new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' }).format(value);
  const getSavedIds = () => {
    try {
      const value: unknown = JSON.parse(localStorage.getItem('greengrow-list') || '[]');
      return new Set(Array.isArray(value) ? value.filter((item) => item && typeof item.id === 'string').map((item) => item.id) : []);
    } catch { return new Set<string>(); }
  };
  function cardMarkup(product: Product) {
    const id = escapeHtml(product.id);
    const name = escapeHtml(product.name);
    const type = escapeHtml(product.type || product.category);
    const image = escapeHtml(product.image || '/images/products/seed-archive.png');
    const saved = getSavedIds().has(product.id);
    const prices = (product.packVariants || []).map((variant) => `<div class="pack-price-option"><span>${variant.quantity} Samen</span><strong>${formatPrice(variant.priceEUR)}</strong></div>`).join('');
    return `<article class="product-card" data-category="${type}" data-id="${id}" data-name="${name}" data-type="${type}" data-image="${image}" data-status="${escapeHtml(product.status)}">
      <a class="product-image product-image-link" href="/product/${encodeURIComponent(id)}/" aria-label="Details zu ${name} öffnen"><span class="product-tag">Sortimentsvorschau</span><img src="${image}" alt="Symbolbild aus dem SEED³X Bildarchiv; kein verifiziertes Einzelproduktfoto" loading="lazy" decoding="async" width="280" height="280"/></a>
      <div class="product-info"><span class="product-type">${type}</span><h3><a class="product-title-link" href="/product/${encodeURIComponent(id)}/">${name}</a></h3>
      <p>Individuelle Sortenangaben werden vor einer Veröffentlichung anhand verlässlicher Züchter- oder Herstellerquellen geprüft.</p>
      ${prices ? `<div class="pack-price-preview" aria-label="Preisvorschau je Packungsgröße"><span class="pack-price-heading">Preise je Packungsgröße</span><div class="pack-price-grid">${prices}</div></div>` : ''}
      <span class="product-note">Katalogname und Kategorie · Sortenmerkmale noch nicht verifiziert</span><div class="product-actions"><a class="text-link product-detail-link" href="/product/${encodeURIComponent(id)}/">Details ansehen ↗</a><button class="save-button" type="button" data-save="${id}" aria-pressed="${saved}">${saved ? '✓ Gemerkt' : '+ Merken'}</button></div></div></article>`;
  }
  function sortAndFilterProducts() {
    const query = (search?.value || '').trim().toLocaleLowerCase('de');
    filteredProducts = allProducts.filter((product) => {
      const type = product.type || product.category || '';
      const matchesCategory = activeFilter === 'Alle' || type === activeFilter;
      const searchable = [product.name, type, product.id, product.description].filter(Boolean).join(' ').toLocaleLowerCase('de');
      return matchesCategory && (!query || searchable.includes(query));
    });
    const mode = sortSelect?.value || 'source';
    if (mode === 'name-asc') filteredProducts.sort((a, b) => a.name.localeCompare(b.name, 'de', { sensitivity: 'base' }));
    else if (mode === 'name-desc') filteredProducts.sort((a, b) => b.name.localeCompare(a.name, 'de', { sensitivity: 'base' }));
    else if (mode === 'category') filteredProducts.sort((a, b) => (a.type || a.category || '').localeCompare(b.type || b.category || '', 'de'));
  }
  function renderProducts(reset = false) {
    if (!grid) return;
    if (reset) shownCount = pageSize;
    const visibleProducts = filteredProducts.slice(0, shownCount);
    grid.innerHTML = visibleProducts.map(cardMarkup).join('');
    if (count) count.textContent = filteredProducts.length.toLocaleString('de-DE') + (filteredProducts.length === 1 ? ' Katalogeintrag' : ' Katalogeinträge');
    if (empty) empty.hidden = filteredProducts.length !== 0;
    if (loadMore) {
      const remaining = Math.max(0, filteredProducts.length - visibleProducts.length);
      loadMore.hidden = remaining === 0;
      loadMore.textContent = remaining ? `Mehr anzeigen (${Math.min(pageSize, remaining)} weitere)` : 'Alle Einträge angezeigt';
      loadMore.setAttribute('aria-label', remaining ? `${Math.min(pageSize, remaining)} weitere Produkte anzeigen` : 'Alle Einträge angezeigt');
    }
  }
  function applyFilters() {
    sortAndFilterProducts();
    renderProducts(true);
  }
  filterButtons.forEach((button) => button.addEventListener('click', () => {
    activeFilter = button.dataset.filter || 'Alle';
    filterButtons.forEach((item) => item.setAttribute('aria-pressed', String(item.dataset.filter === activeFilter)));
    applyFilters();
    if (button.hasAttribute('data-category-entry')) document.querySelector('#sortiment')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }));
  search?.addEventListener('input', applyFilters);
  sortSelect?.addEventListener('change', applyFilters);
  loadMore?.addEventListener('click', () => {
    shownCount += pageSize;
    renderProducts(false);
  });
  grid?.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const button = target.closest<HTMLButtonElement>('[data-save]');
    if (!button) return;
    const card = button.closest<HTMLElement>('.product-card');
    const id = card?.dataset.id;
    if (!card || !id) return;
    event.preventDefault();
    const name = card.dataset.name || 'Unbenanntes Produkt';
    const type = card.dataset.type || 'Nicht zugeordnet';
    const image = card.dataset.image || '';
    try {
      const saved = JSON.parse(localStorage.getItem('greengrow-list') || '[]');
      const safeSaved = Array.isArray(saved) ? saved.filter((item) => item && typeof item.id === 'string') : [];
      const exists = safeSaved.some((item) => item.id === id);
      const next = exists ? safeSaved.filter((item) => item.id !== id) : [...safeSaved, { id, name, type, image }];
      localStorage.setItem('greengrow-list', JSON.stringify(next));
      document.querySelectorAll<HTMLButtonElement>('[data-save]').forEach((item) => {
        const isSaved = next.some((savedItem) => savedItem.id === item.dataset.save);
        item.setAttribute('aria-pressed', String(isSaved));
        item.textContent = isSaved ? '✓ Gemerkt' : '+ Merken';
      });
    } catch {
      window.alert('Deine Merkliste konnte auf diesem Gerät nicht gespeichert werden. Bitte prüfe die Browser-Einstellungen.');
    }
  });
  window.addEventListener('storage', (event) => {
    if (event.key === 'greengrow-list') {
      const savedIds = getSavedIds();
      document.querySelectorAll<HTMLButtonElement>('[data-save]').forEach((button) => {
        const isSaved = savedIds.has(button.dataset.save || '');
        button.setAttribute('aria-pressed', String(isSaved));
        button.textContent = isSaved ? '✓ Gemerkt' : '+ Merken';
      });
    }
  });
  sortAndFilterProducts();
  renderProducts(false);
</script>
<style>
  .cali-editorial-section{padding-top:clamp(2.5rem,5vw,4.5rem);padding-bottom:clamp(2.5rem,5vw,4.5rem)}
  .cali-editorial-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin-top:1.5rem}
  .cali-editorial-card{display:flex;flex-direction:column;min-width:0;padding:clamp(1.2rem,2.5vw,2rem);border:1px solid var(--line);border-radius:18px;background:#fffefa;box-shadow:0 10px 28px #20362a08}
  .cali-editorial-card h3{margin:1rem 0 .65rem;font-family:Georgia,"Times New Roman",serif;font-size:clamp(1.5rem,2.5vw,2.15rem);font-weight:500;letter-spacing:-.04em;color:var(--green)}
  .cali-editorial-card p{flex:1;color:var(--muted);font-size:.93rem;line-height:1.8}
    .rubric-status{align-self:flex-start;margin:1rem 0;padding:.45rem .7rem;border-radius:999px;background:#f0eaf7;color:#59496f;font-size:.72rem;font-weight:750;letter-spacing:.02em}
    .rubric-disclaimer{margin-top:1rem;color:var(--muted);font-size:.82rem;line-height:1.7}
  .category-entry-section{padding-top:clamp(2.5rem,5vw,4.5rem);padding-bottom:clamp(2.5rem,5vw,4.5rem)}
  .category-entry-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin-top:1.5rem}
  .category-entry-card{display:flex;flex-direction:column;min-width:0;padding:clamp(1.15rem,2vw,1.7rem);border:1px solid var(--line);border-radius:18px;background:#fffdf8;box-shadow:0 10px 28px #20362a08}
  .category-entry-index{color:#718069;font-size:.65rem;letter-spacing:.14em;font-weight:800}
  .category-entry-card h3{margin:1rem 0 .55rem;font-family:Georgia,"Times New Roman",serif;font-size:clamp(1.45rem,2.2vw,2rem);font-weight:500;letter-spacing:-.04em}
  .category-entry-card p{flex:1;color:var(--muted);font-size:.9rem;line-height:1.75}
  .category-entry-footer{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.75rem;margin-top:1.1rem;padding-top:1rem;border-top:1px solid var(--line)}
  .category-entry-footer>span{font-size:.78rem;color:var(--muted)}
  .category-entry-link{display:inline-flex;align-items:center;gap:.45rem;border:0;background:transparent;color:var(--green);font:inherit;font-size:.82rem;font-weight:750;cursor:pointer}
  .category-entry-link:hover{color:var(--green-2)}
  .category-entry-link:focus-visible,.all-catalog-entry .button:focus-visible{outline:3px solid #8ba96b;outline-offset:3px}
  .all-catalog-entry{display:flex;align-items:center;justify-content:space-between;gap:1.25rem;margin-top:1rem;padding:1.25rem 1.4rem;border:1px solid var(--line);border-radius:16px;background:#f4f2e8}
  .all-catalog-entry>div{display:grid;gap:.3rem}
  .all-catalog-entry strong{font-size:.95rem}
  .all-catalog-entry span{color:var(--muted);font-size:.85rem}
  .shop-page-hero{position:relative;overflow:hidden;padding-top:clamp(3.5rem,7vw,6rem);padding-bottom:clamp(2.8rem,5vw,4rem);background:radial-gradient(ellipse at 90% 15%,#dfe8c7 0,transparent 42%),linear-gradient(120deg,#f4f1e5,#e9eddd)}
  .shop-page-hero h1{font-family:Georgia,"Times New Roman",serif;font-weight:450;letter-spacing:-.065em;line-height:.98;font-size:clamp(3rem,6.8vw,6rem);margin:1rem 0}
  .shop-page-hero h1 em{font-weight:450;color:var(--green-2)}
  .shop-page-hero p{max-width:680px;font-size:1rem;line-height:1.8}
  .shop-hero-meta{display:flex;gap:1rem 2rem;flex-wrap:wrap;margin-top:2rem;padding-top:1rem;border-top:1px solid #cfd8c5;color:#718069;font-size:.65rem;letter-spacing:.16em;font-weight:800}
  .shop-catalog{padding-top:clamp(2.5rem,5vw,4rem)}
  .shop-catalog .section-heading{align-items:start}
  .shop-catalog .catalog-tools{padding:1.25rem;border:1px solid var(--line);border-radius:20px;background:#fffdf8;box-shadow:0 16px 45px #20362a08;margin:1.5rem 0}
  .shop-catalog .search-box{max-width:none}
  .shop-catalog .filter-row{margin:.5rem 0}
  .shop-catalog .product-grid{gap:1rem}\n  .catalog-load-more{display:block;margin:1.5rem auto 0;min-width:12rem}\n  .catalog-load-more[hidden]{display:none}
