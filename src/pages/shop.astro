---
import Layout from '../layouts/Layout.astro';
import seedProducts from '../data/seed-products.json';
const sharedProductImage = 'https://raw.githubusercontent.com/lejoker3251-dot/GreenGrow-/feature/premium-storefront-v1/images/White%201.png.JPG';
const products = seedProducts.map((product) => ({
  ...product,
  type: product.category,
  tag: 'Sortimentsvorschau',
  description: product.description || 'Eine individuelle Beschreibung liegt für diesen Katalogeintrag noch nicht vor.',
  image: sharedProductImage,
}));
const categoryDefinitions = [
  { name: 'Autoflowering', title: 'Autoflowering', description: 'Katalogeinträge, die in der Quelle als Automatic Flowering geführt werden.' },
  { name: 'Feminisierte Samen', title: 'Feminisierte Samen', description: 'Katalogeinträge, die in der Quelle als Feminized geführt werden.' },
  { name: 'Reguläre Samen', title: 'Reguläre Samen', description: 'Katalogeinträge, die in der Quelle als Regular geführt werden.' },
];
const categories = ['Alle', ...categoryDefinitions.map((category) => category.name)];
const categoryCounts = Object.fromEntries(categoryDefinitions.map((category) => [
  category.name,
  products.filter((product) => product.category === category.name).length,
]));
const catalogCount = products.length;
---
<Layout title="Shop entdecken – SEED³X" description="Der SEED³X Katalog mit Suche, Saatentypen, Filtern und Sortierung. Alle Einträge sind derzeit Entwürfe.">
  <section class="page-hero shop-page-hero">
    <span class="eyebrow">SEED³X · THE COLLECTION</span>
    <h1>Der Shop.<br/><em>Alles an einem Ort.</em></h1>
    <p>Finde den passenden Einstieg über den Saatentyp oder durchsuche den gesamten Katalog. Alle Einträge sind noch Entwürfe und kein freigegebener Verkaufskatalog.</p>
    <div class="shop-hero-meta"><span>{catalogCount.toLocaleString('de-DE')} KATALOGEINTRÄGE</span><span>BOTANICAL COLLECTION</span></div>
  </section>
  <section class="section category-entry-section" aria-labelledby="category-entry-title">
    <div class="section-heading">
      <div><span class="eyebrow">Einfacher Einstieg</span><h2 id="category-entry-title">Finde deinen Saatentyp.</h2><p>Die Einstiege folgen den drei Kategorien, die im vorhandenen Katalog hinterlegt sind. Die Anzahl zeigt Katalogeinträge, keine verfügbaren oder freigegebenen Produkte.</p></div>
      <span class="section-kicker">KATEGORIEN · 03</span>
    </div>
    <div class="category-entry-grid">
      {categoryDefinitions.map((category, index) => (
        <article class="category-entry-card">
          <span class="category-entry-index">0{index + 1} / KATEGORIE</span>
          <h3>{category.title}</h3>
          <p>{category.description}</p>
          <div class="category-entry-footer">
            <span>{categoryCounts[category.name].toLocaleString('de-DE')} Einträge</span>
            <button type="button" class="category-entry-link" data-filter={category.name} data-category-entry="true" aria-pressed="false">Kategorie ansehen <span aria-hidden="true">↘</span></button>
          </div>
        </article>
      ))}
    </div>
    <div class="all-catalog-entry">
      <div><strong>Du möchtest alles durchsehen?</strong><span>Alle {catalogCount.toLocaleString('de-DE')} Katalogeinträge in einer Liste.</span></div>
      <button type="button" class="button" data-filter="Alle" data-category-entry="true" aria-pressed="false">Gesamtes Sortiment ansehen ↘</button>
    </div>
  </section>
  <section class="section shop-catalog" id="sortiment">
    <div class="section-heading"><div><span class="eyebrow">Finde deinen Favoriten</span><h2>Das gesamte Sortiment.</h2><p>Suche nach Namen, filtere nach Saatentyp und sortiere die vorhandenen Katalogeinträge. Produktdaten und Verkaufsfreigaben werden nicht vorweggenommen.</p></div><span class="section-kicker">DAS SORTIMENT · 01</span></div>
    <div class="catalog-tools">
      <label class="search-box"><span aria-hidden="true">⌕</span><input id="product-search" type="search" placeholder="Produkte oder Kategorien suchen …" aria-label="Produkte oder Kategorien suchen"/></label>
      <div class="filter-row" aria-label="Produkte nach Saatentyp filtern">{categories.map((category, index) => <button class="filter-button" data-filter={category} aria-pressed={index === 0 ? 'true' : 'false'}>{category === 'Alle' ? 'Alle Saatentypen' : category}</button>)}</div>
      <div class="catalog-sort"><label for="product-sort">Sortieren</label><select id="product-sort" aria-label="Produkte sortieren"><option value="source">Originale Listenreihenfolge</option><option value="name-asc">Name: A–Z</option><option value="name-desc">Name: Z–A</option><option value="category">Kategorie</option></select></div>
    </div>
    <p class="results-count" id="results-count" aria-live="polite">{catalogCount.toLocaleString('de-DE')} Katalogeinträge · Entwürfe</p>
    <div class="product-grid" id="product-grid">{products.map((product) => <article class="product-card" data-category={product.type} data-id={product.id} data-name={product.name} data-type={product.type} data-image={product.image} data-status={product.status}><div class="product-image"><span class="product-tag">{product.tag}</span><img src={product.image} alt="" loading="lazy" decoding="async" width="280" height="280"/></div><div class="product-info"><span class="product-type">{product.type} · Entwurf</span><h3><a class="product-title-link" href={'/product/' + product.id + '/'}>{product.name}</a></h3><p>{product.description}</p><span class="product-note">Beschreibung aus dem bereitgestellten Katalog · noch nicht verifiziert</span><div class="product-actions"><span class="product-note">Produktdetails folgen</span><button class="save-button" type="button" data-save={product.id} aria-pressed="false">+ Merken</button></div></div></article>)}</div>
    <p class="empty-state" id="no-results" hidden>Keine passenden Produkte gefunden. Versuche einen anderen Suchbegriff oder eine andere Kategorie.</p>
    <div class="notice">Katalogvorschau: Namen und Kategorie stammen aus der bereitgestellten Liste. Das Bild „White 1“ wird einheitlich für alle Katalogeinträge verwendet. Preise, Lagerbestand, geprüfte Sortenangaben und Bestellfunktionen sind nicht eingerichtet; alle Produkte bleiben Entwürfe.</div>
  </section>
</Layout>
<script>
const filterButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const cards = [...document.querySelectorAll<HTMLElement>('.product-card')];
  const search = document.querySelector<HTMLInputElement>('#product-search');
  const count = document.querySelector<HTMLElement>('#results-count');
  const empty = document.querySelector<HTMLElement>('#no-results');
  const sortSelect = document.querySelector<HTMLSelectElement>('#product-sort');
  const grid = document.querySelector<HTMLElement>('#product-grid');
  const originalOrder = new Map(cards.map((card, index) => [card.dataset.id || String(index), index]));
  const requestedFilter = new URLSearchParams(window.location.search).get('typ');
  let activeFilter = filterButtons.some((button) => button.dataset.filter === requestedFilter) ? (requestedFilter || 'Alle') : 'Alle';
  function sortProducts() {
    if (!grid || !sortSelect) return;
    const mode = sortSelect.value;
    const sorted = [...cards].sort((a, b) => {
      if (mode === 'name-asc') return (a.dataset.name || '').localeCompare(b.dataset.name || '', 'de', { sensitivity: 'base' });
      if (mode === 'name-desc') return (b.dataset.name || '').localeCompare(a.dataset.name || '', 'de', { sensitivity: 'base' });
      if (mode === 'category') {
        const categoryCompare = (a.dataset.category || '').localeCompare(b.dataset.category || '', 'de');
        if (categoryCompare !== 0) return categoryCompare;
      }
      return (originalOrder.get(a.dataset.id || '') ?? 0) - (originalOrder.get(b.dataset.id || '') ?? 0);
    });
    sorted.forEach((card) => grid.append(card));
  }
  function readSavedProducts(): { id: string; name: string; type: string; image: string }[] {
    try {
      const value: unknown = JSON.parse(localStorage.getItem('greengrow-list') || '[]');
      if (!Array.isArray(value)) return [];
      return value.filter((item): item is { id: string; name: string; type: string; image: string } =>
        item && typeof item.id === 'string' && typeof item.name === 'string' &&
        typeof item.type === 'string' && typeof item.image === 'string'
      );
    } catch {
      return [];
    }
  }
  function syncSavedButtons() {
    const savedIds = new Set(readSavedProducts().map((item) => item.id));
    document.querySelectorAll<HTMLButtonElement>('[data-save]').forEach((button) => {
      const isSaved = savedIds.has(button.dataset.save || '');
      button.setAttribute('aria-pressed', String(isSaved));
      button.textContent = isSaved ? '✓ Gemerkt' : '+ Merken';
    });
    const savedCount = document.querySelector('#cart-count');
    if (savedCount) savedCount.textContent = String(savedIds.size);
  }
  function updateProducts() {
    const query = (search?.value || '').trim().toLocaleLowerCase('de');
    let visible = 0;
    cards.forEach((card) => {
      const matchesCategory = activeFilter === 'Alle' || card.dataset.category === activeFilter;
      const matchesQuery = !query || (card.dataset.name || '').toLocaleLowerCase('de').includes(query) || (card.dataset.category || '').toLocaleLowerCase('de').includes(query);
      const show = matchesCategory && matchesQuery;
      card.hidden = !show;
      if (show) visible++;
    });
    if (count) count.textContent = visible + (visible === 1 ? ' Produkt' : ' Produkte');
    if (empty) empty.hidden = visible !== 0;
  }
  filterButtons.forEach((button) => button.addEventListener('click', () => {
    activeFilter = button.dataset.filter || 'Alle';
    filterButtons.forEach((item) => item.setAttribute('aria-pressed', String(item.dataset.filter === activeFilter)));
    updateProducts();
    if (button.hasAttribute('data-category-entry')) {
      document.querySelector('#sortiment')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }));
  search?.addEventListener('input', updateProducts);
  sortSelect?.addEventListener('change', sortProducts);
  sortProducts();
  filterButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.filter === activeFilter)));
  updateProducts();
  document.querySelectorAll<HTMLButtonElement>('[data-save]').forEach((button) => button.addEventListener('click', () => {
    const card = button.closest<HTMLElement>('.product-card');
    if (!card) return;
    const id = card.dataset.id;
    if (!id) return;
    const saved = readSavedProducts();
    const exists = saved.some((item) => item.id === id);
    const next = exists
      ? saved.filter((item) => item.id !== id)
      : [...saved, {
          id,
          name: card.dataset.name || 'Unbenanntes Produkt',
          type: card.dataset.type || 'Nicht zugeordnet',
          image: card.dataset.image || ''
        }];
    try {
      localStorage.setItem('greengrow-list', JSON.stringify(next));
      syncSavedButtons();
    } catch {
      window.alert('Deine Merkliste konnte auf diesem Gerät nicht gespeichert werden. Bitte prüfe die Browser-Einstellungen.');
    }
  }));
  window.addEventListener('storage', (event) => {
    if (event.key === 'greengrow-list') syncSavedButtons();
  });
  syncSavedButtons();
</script>
<style>
  .category-entry-section{padding-top:clamp(2.5rem,5vw,4.5rem);padding-bottom:clamp(2.5rem,5vw,4.5rem)}
  .category-entry-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin-top:1.5rem}
  .category-entry-card{display:flex;flex-direction:column;min-width:0;padding:clamp(1.15rem,2vw,1.7rem);border:1px solid var(--line);border-radius:18px;background:#fffdf8;box-shadow:0 10px 28px #20362a08}
  .category-entry-index{color:#718069;font-size:.65rem;letter-spacing:.14em;font-weight:800}
  .category-entry-card h3{margin:1rem 0 .55rem;font-family:Georgia,"Times New Roman",serif;font-size:clamp(1.45rem,2.2vw,2rem);font-weight:500;letter-spacing:-.04em}
  .category-entry-card p{flex:1;color:var(--muted);font-size:.9rem;line-height:1.75}
  .category-entry-footer{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.75rem;margin-top:1.1rem;padding-top:1rem;border-top:1px solid var(--line)}
  .category-entry-footer>span{font-size:.78rem;color:var(--muted)}
  .category-entry-link{display:inline-flex;align-items:center;gap:.45rem;border:0;background:transparent;color:var(--green);font:inherit;font-size:.82rem;font-weight:750;cursor:pointer}
  .category-entry-link:hover{color:var(--green-2)}
  .category-entry-link:focus-visible,.all-catalog-entry .button:focus-visible{outline:3px solid #8ba96b;outline-offset:3px}
  .all-catalog-entry{display:flex;align-items:center;justify-content:space-between;gap:1.25rem;margin-top:1rem;padding:1.25rem 1.4rem;border:1px solid var(--line);border-radius:16px;background:#f4f2e8}
  .all-catalog-entry>div{display:grid;gap:.3rem}
  .all-catalog-entry strong{font-size:.95rem}
  .all-catalog-entry span{color:var(--muted);font-size:.85rem}
  .shop-page-hero{position:relative;overflow:hidden;padding-top:clamp(3.5rem,7vw,6rem);padding-bottom:clamp(2.8rem,5vw,4rem);background:radial-gradient(ellipse at 90% 15%,#dfe8c7 0,transparent 42%),linear-gradient(120deg,#f4f1e5,#e9eddd)}
  .shop-page-hero h1{font-family:Georgia,"Times New Roman",serif;font-weight:450;letter-spacing:-.065em;line-height:.98;font-size:clamp(3rem,6.8vw,6rem);margin:1rem 0}
  .shop-page-hero h1 em{font-weight:450;color:var(--green-2)}
  .shop-page-hero p{max-width:680px;font-size:1rem;line-height:1.8}
  .shop-hero-meta{display:flex;gap:1rem 2rem;flex-wrap:wrap;margin-top:2rem;padding-top:1rem;border-top:1px solid #cfd8c5;color:#718069;font-size:.65rem;letter-spacing:.16em;font-weight:800}
  .shop-catalog{padding-top:clamp(2.5rem,5vw,4rem)}
  .shop-catalog .section-heading{align-items:start}
  .shop-catalog .catalog-tools{padding:1.25rem;border:1px solid var(--line);border-radius:20px;background:#fffdf8;box-shadow:0 16px 45px #20362a08;margin:1.5rem 0}
  .shop-catalog .search-box{max-width:none}
  .shop-catalog .filter-row{margin:.5rem 0}
  .shop-catalog .product-grid{gap:1rem}
  .shop-catalog .product-card{box-shadow:0 6px 20px #20362a06}
  .shop-catalog .product-card:hover{box-shadow:0 18px 42px #20362a12}
  .shop-catalog .product-image{background:linear-gradient(145deg,#f2f2e8,#e7eadb)}
  .shop-catalog .notice{margin-top:2rem}
  .shop-teaser{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(2rem,7vw,7rem);align-items:center;background:#f4f2e8}
  .shop-teaser-art{min-height:340px;position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:.8rem;border-radius:22px;background:radial-gradient(ellipse at center,#3c573b,#17281d 70%);color:#e3e5d2;letter-spacing:.24em}
  .shop-teaser-art span:first-child{font-family:Georgia,serif;font-size:clamp(2.8rem,6vw,5.2rem);letter-spacing:-.06em}
  .shop-teaser-art span:nth-child(2){font-size:.58rem;color:#c7c9a5}
  .shop-teaser-art i{position:absolute;width:62%;height:1px;background:#c9bb8d4a;transform:rotate(-24deg)}
  .shop-teaser-art i:nth-of-type(2){transform:rotate(22deg);width:80%}
  .shop-teaser-art i:nth-of-type(3){transform:rotate(68deg);height:75%;width:1px}
  .shop-teaser-copy h2{font-family:Georgia,serif;font-size:clamp(2.5rem,4.7vw,4.6rem);font-weight:450;letter-spacing:-.06em;line-height:1.02;margin:.8rem 0 1rem}
  .shop-teaser-copy h2 em{color:var(--green-2);font-weight:450}
  .shop-teaser-copy p{max-width:600px;color:var(--muted);line-height:1.85}
  .shop-teaser-note{display:block;margin-top:1rem;color:#768271;font-size:.75rem}
  @media(max-width:760px){.category-entry-grid{grid-template-columns:1fr}.category-entry-card{padding:1.2rem}.all-catalog-entry{align-items:stretch;flex-direction:column}.all-catalog-entry .button{width:100%}}
  @media(max-width:700px){.shop-teaser{grid-template-columns:1fr}.shop-teaser-art{min-height:220px}.shop-teaser-copy .button{width:100%}.shop-catalog .catalog-tools{padding:.9rem}.shop-hero-meta{font-size:.56rem}}
</style>
