---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Deine Merkliste – GreenGrow Seeds" description="Deine vorgemerkten Saatgut-Ideen bei GreenGrow Seeds.">
  <section class="page-hero"><span class="eyebrow">Für später gespeichert</span><h1>Deine Merkliste.</h1><p>Hier findest du die Saatgut-Ideen, die du dir vorgemerkt hast. Dies ist eine lokale Vorschau-Merkliste und kein Warenkorb für echte Bestellungen.</p></section>
  <section class="section"><div id="saved-list" class="saved-list"><div class="empty-state"><h2>Deine Liste wird geladen …</h2><p>Moment bitte.</p></div></div><div class="notice">Noch kein Checkout: Es werden keine Bestellungen ausgelöst und keine Zahlungsdaten verarbeitet.</div><a class="button" href="/shop/#sortiment">Weiter entdecken ↗</a></section>
</Layout>
<script>
  const root = document.querySelector<HTMLElement>('#saved-list');
  function renderList() {
    if (!root) return;
    let items: {id:string;name:string;type:string;image:string}[] = [];
    try { items = JSON.parse(localStorage.getItem('greengrow-list') || '[]'); } catch {}
    const count = document.querySelector('#cart-count');
    if (count) count.textContent = String(items.length);
    if (!items.length) { root.innerHTML = '<div class="empty-state"><h2>Noch nichts vorgemerkt</h2><p>Entdecke das Sortiment und speichere deine Favoriten für später.</p></div>'; return; }
    root.innerHTML = items.map((item) => `<article class="saved-item"><img src="${item.image}" alt="" width="70" height="70"><div><h3>${item.name}</h3><p>${item.type} · Beispielprodukt</p></div><button class="remove-button" type="button" data-remove="${item.id}">Entfernen</button></article>`).join('');
    root.querySelectorAll<HTMLButtonElement>('[data-remove]').forEach((button) => button.addEventListener('click', () => {
      const id = button.dataset.remove;
      items = items.filter((item) => item.id !== id);
      localStorage.setItem('greengrow-list', JSON.stringify(items));
      renderList();
    }));
  }
  renderList();
</script>
