<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101810" />
    <meta name="description" content="Eigenständige technische Demonstration einer dreidimensionalen botanischen Szene." />
    <title>Botanical Lab · 3D-Demonstration</title>
    <style>
      :root { color-scheme: dark; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: #101810; color: #edf0df; }
      * { box-sizing: border-box; }
      body { margin: 0; min-height: 100vh; background: radial-gradient(ellipse at 72% 36%, #273626 0%, #172217 34%, #101810 74%); }
      .page { width: min(1240px, 100% - 40px); margin: 0 auto; padding: 30px 0 48px; }
      header { display:flex; align-items:center; justify-content:space-between; gap:16px; padding: 6px 0 30px; border-bottom:1px solid #dce7c31c; }
      .brand { font-size:.78rem; letter-spacing:.22em; text-transform:uppercase; color:#d8e8b7; font-weight:700; }
      .tag { font-size:.72rem; color:#b4c2a8; letter-spacing:.12em; text-transform:uppercase; }
      main { display:grid; grid-template-columns:minmax(0, .85fr) minmax(0, 1.15fr); gap:34px; align-items:center; padding-top: clamp(34px, 7vw, 88px); }
      .eyebrow { color:#b9d28d; text-transform:uppercase; letter-spacing:.2em; font-size:.72rem; font-weight:700; }
      h1 { font-size:clamp(2.6rem, 6vw, 5.4rem); letter-spacing:-.065em; line-height:.98; font-weight:500; margin:20px 0; max-width:9ch; }
      h1 em { color:#c5dba2; font-family: Georgia, serif; font-weight:400; }
      .intro { color:#bdc8b8; line-height:1.75; max-width:42ch; font-size:1rem; }
      .notes { display:grid; gap:14px; margin-top:30px; }
      .note { display:flex; gap:14px; align-items:flex-start; color:#c7d0bf; font-size:.9rem; line-height:1.55; }
      .note b { display:block; color:#f0f2e8; font-weight:600; margin-bottom:2px; }
      .num { color:#b9d28d; font-size:.72rem; letter-spacing:.1em; padding-top:3px; }
      .stage { min-height:560px; position:relative; border:1px solid #e0e9cb20; border-radius:28px; overflow:hidden; background:linear-gradient(145deg,#ffffff09,#ffffff02); box-shadow:0 28px 100px #0005, inset 0 1px #ffffff0c; }
      canvas { display:block; width:100%; height:100%; min-height:560px; position:absolute; inset:0; }
      .fallback { position:absolute; inset:0; display:grid; place-items:center; color:#c9d9ad; font-size:.9rem; text-align:center; padding:28px; background:radial-gradient(ellipse,#5a704733,transparent 65%); }
      .stage.ready .fallback { opacity:0; pointer-events:none; }
      .stage-label { position:absolute; z-index:2; left:22px; top:22px; font-size:.67rem; letter-spacing:.18em; color:#d2ddc0; text-transform:uppercase; pointer-events:none; }
      .stage-caption { position:absolute; z-index:2; left:22px; right:22px; bottom:20px; display:flex; justify-content:space-between; gap:12px; color:#c2cfb7; font-size:.7rem; letter-spacing:.12em; text-transform:uppercase; pointer-events:none; }
      .controls { display:flex; gap:10px; flex-wrap:wrap; margin-top:22px; }
      button { appearance:none; border:1px solid #c5dba244; border-radius:999px; background:#c5dba211; color:#eff4e5; padding:11px 16px; font:inherit; font-size:.82rem; cursor:pointer; }
      button:hover { background:#c5dba222; }
      button:focus-visible { outline:2px solid #c5dba2; outline-offset:3px; }
      .status { min-height:1.5em; margin-top:12px; color:#9fb095; font-size:.76rem; }
      footer { margin-top:40px; padding-top:18px; border-top:1px solid #dce7c31c; color:#8f9f88; font-size:.75rem; line-height:1.6; }
      @media(max-width:820px) { .page { width:min(100% - 28px, 620px); } main { grid-template-columns:1fr; gap:26px; padding-top:42px; } h1 { max-width:11ch; } .stage,.stage canvas { min-height: min(120vw, 540px); } header { padding-bottom:20px; } }
      @media(prefers-reduced-motion:reduce) { *,*::before,*::after { scroll-behavior:auto!important; } }
    </style>
  </head>
  <body>
    <div class="page">
      <header><div class="brand">Botanical Lab</div><div class="tag">Independent 3D study · 01</div></header>
      <main>
        <section>
          <div class="eyebrow">Form · Light · Motion</div>
          <h1>Wachstum in <em>drei Dimensionen.</em></h1>
          <p class="intro">Eine eigenständige technische Studie für eine botanische 3D-Szene. Sie erprobt räumliches Licht, sanfte Blattbewegung und eine Kameraperspektive, die auf Zeigerbewegungen reagiert – ohne die Hauptseite zu verändern.</p>
          <div class="notes">
            <div class="note"><span class="num">01</span><div><b>Räumliche Beleuchtung</b>Weiches Umgebungslicht, gerichtetes Hauptlicht und ein dezentes Kantenlicht.</div></div>
            <div class="note"><span class="num">02</span><div><b>Organische Bewegung</b>Blätter reagieren mit leicht versetzten Phasen statt als starre Einheit.</div></div>
            <div class="note"><span class="num">03</span><div><b>Rücksicht auf Geräte</b>Begrenzte Pixelauflösung, pausierte Darstellung außerhalb des Sichtbereichs und Unterstützung für reduzierte Bewegung.</div></div>
          </div>
          <div class="controls"><button id="motion-toggle" type="button" aria-pressed="false">Animation pausieren</button><button id="view-reset" type="button">Ansicht zurücksetzen</button></div>
          <div class="status" id="scene-status" role="status" aria-live="polite">3D-Szene wird vorbereitet …</div>
        </section>
        <section class="stage" id="stage" aria-label="Interaktive botanische 3D-Demonstration">
          <div class="stage-label">Study no. 01 / Seedling</div>
          <canvas id="botanical-canvas" aria-label="Dreidimensionales Modell eines Keimlings mit Wurzeln und Blättern"></canvas>
          <div class="fallback">Die interaktive Szene benötigt WebGL. Diese Fläche bleibt auch ohne 3D-Unterstützung ruhig und lesbar.</div>
          <div class="stage-caption"><span>Rooted in nature</span><span>Gentle motion</span></div>
        </section>
      </main>
      <footer>Technische Vorschau, unabhängig von der bestehenden Startseite. Maus-/Touch-Interaktion ist optional; die Animation kann jederzeit pausiert werden.</footer>
    </div>
    <script type="module">
      const canvas = document.querySelector('#botanical-canvas');
      const stage = document.querySelector('#stage');
      const status = document.querySelector('#scene-status');
      const motionButton = document.querySelector('#motion-toggle');
      const resetButton = document.querySelector('#view-reset');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduceMotion) motionButton.textContent = 'Animation deaktiviert (Systemeinstellung)';
      let renderer, scene, camera, plant, leaves = [], raf = 0, observer, resizeObserver;
      let paused = reduceMotion, disposed = false, pointerX = 0, pointerY = 0, targetX = 0, targetY = 0;
      let startTime = 0;
      const materials = [];
      const geometries = [];
      const rememberMaterial = (m) => (materials.push(m), m);
      const rememberGeometry = (g) => (geometries.push(g), g);
      const makeMaterial = (opts) => rememberMaterial(new THREE.MeshStandardMaterial(opts));
      let THREE;
      const schedule = () => { if (!raf && !paused && !disposed && document.visibilityState === 'visible') raf = requestAnimationFrame(render); };
      const dispose = () => {
        disposed = true;
        if (raf) cancelAnimationFrame(raf);
        observer?.disconnect(); resizeObserver?.disconnect();
        geometries.forEach(g => g.dispose());
        materials.forEach(m => m.dispose());
        renderer?.dispose();
      };
      try {
        THREE = await import('https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js');
        if (disposed) throw new Error('Scene was disposed during loading');
        scene = new THREE.Scene();
        camera = new THREE.PerspectiveCamera(35, 1, 0.1, 100);
        camera.position.set(0, 0.18, 7.5);
        renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: false, powerPreference: 'low-power' });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.35));
        renderer.outputColorSpace = THREE.SRGBColorSpace;
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.toneMappingExposure = 1.08;
        scene.add(new THREE.HemisphereLight('#e9f1d8', '#172519', 1.9));
        const key = new THREE.DirectionalLight('#fff0c9', 3.2); key.position.set(3.2, 4.5, 4); scene.add(key);
        const rim = new THREE.PointLight('#a9d49a', 13, 12); rim.position.set(-3, 1.5, -2); scene.add(rim);
        plant = new THREE.Group(); scene.add(plant);
        const stemMat = makeMaterial({ color:'#78975f', roughness:.55 });
        const rootMat = makeMaterial({ color:'#bba17a', roughness:.8 });
        const leafMat = makeMaterial({ color:'#6f9657', roughness:.42, side:THREE.DoubleSide });
        const leafLight = makeMaterial({ color:'#a9c77d', roughness:.46, side:THREE.DoubleSide });
        const soilMat = rememberMaterial(new THREE.MeshPhysicalMaterial({ color:'#8f7855', roughness:.58, transparent:true, opacity:.16, side:THREE.DoubleSide }));
        const orb = new THREE.Mesh(rememberGeometry(new THREE.SphereGeometry(1.36, 36, 28)), soilMat);
        orb.position.set(0,-.38,-.2); plant.add(orb);
        const shell = new THREE.Mesh(rememberGeometry(new THREE.SphereGeometry(1.4, 28, 22)), rememberMaterial(new THREE.MeshBasicMaterial({ color:'#d5d9a8', transparent:true, opacity:.15, wireframe:true })));
        shell.position.copy(orb.position); plant.add(shell);
        const tube = (points, radius, mat) => {
          const curve = new THREE.CatmullRomCurve3(points.map(p=>new THREE.Vector3(...p)));
          const mesh = new THREE.Mesh(rememberGeometry(new THREE.TubeGeometry(curve, 48, radius, 7, false)), mat);
          plant.add(mesh); return mesh;
        };
        tube([[0,-.3,0],[.01,.08,0],[-.025,.42,.01],[.025,.78,0],[.01,1.12,0],[.07,1.48,0],[.03,1.76,0]],.034,stemMat);
        [
          [[0,-.27,.02],[-.06,-.58,.04],[-.12,-.88,.08],[-.2,-1.15,.08],[-.18,-1.42,.08]],
          [[0,-.3,.02],[.13,-.6,.02],[.26,-.88,.02],[.4,-1.1,.02],[.49,-1.33,.02]],
          [[-.08,-.75,.05],[-.3,-.87,.07],[-.46,-1.05,.08],[-.59,-1.18,.08]],
          [[.24,-.86,.02],[.14,-1.03,.03],[.11,-1.22,.02]],
          [[.39,-1.08,.02],[.62,-1.14,.04],[.73,-1.28,.02]]
        ].forEach((pts,i)=>tube(pts,.009+(i%2)*.005,rootMat));
        const leaf = (x,y,z,sx,sy,sz,rz,mat,phase) => {
          const group = new THREE.Group(); group.position.set(x,y,z); group.rotation.z=rz; plant.add(group);
          const mesh = new THREE.Mesh(rememberGeometry(new THREE.SphereGeometry(1,24,18)),mat);
          mesh.scale.set(sx,sy,sz); group.add(mesh);
          const veinMat = makeMaterial({ color:'#d7e2ad', roughness:.7 });
          const vein = new THREE.Mesh(rememberGeometry(new THREE.CylinderGeometry(.006,.003,sy*1.35,5)),veinMat);
          vein.position.set(0,sy*.1,sz*.8); vein.rotation.z=-rz*.18; group.add(vein);
          leaves.push({group, base:rz, phase}); return group;
        };
        leaf(-.34,.88,.02,.51,.19,.09,-.48,leafMat,.3);
        leaf(.36,1.12,.03,.54,.2,.09,.47,leafLight,1.2);
        leaf(-.23,1.43,.02,.4,.16,.08,-.62,leafLight,2.1);
        leaf(.23,1.61,.02,.36,.15,.08,.5,leafMat,2.8);
        leaf(.015,1.84,0,.2,.29,.08,-.08,leafLight,1.7);
        const seed = new THREE.Mesh(rememberGeometry(new THREE.SphereGeometry(1,22,16)),makeMaterial({ color:'#bca16c', roughness:.48 }));
        seed.position.set(0,-.48,.35); seed.scale.set(.14,.2,.12); seed.rotation.z=-.3; plant.add(seed);
        const ring = new THREE.Mesh(rememberGeometry(new THREE.TorusGeometry(1.62,.008,6,120)),rememberMaterial(new THREE.MeshBasicMaterial({ color:'#d0d7a2', transparent:true, opacity:.3 })));
        ring.position.set(0,-.35,-.38); ring.rotation.x=Math.PI*.36; plant.add(ring);
        const count = 34, positions = new Float32Array(count*3);
        for(let i=0;i<count;i++){ const a=i*2.399, r=.68+(i%7)*.16; positions[i*3]=Math.cos(a)*r; positions[i*3+1]=-1.1+((i*13)%31)/10; positions[i*3+2]=-.4+Math.sin(a)*.55; }
        const pg=rememberGeometry(new THREE.BufferGeometry()); pg.setAttribute('position',new THREE.BufferAttribute(positions,3));
        const particles=new THREE.Points(pg,rememberMaterial(new THREE.PointsMaterial({color:'#e1ddb5',size:.024,transparent:true,opacity:.62}))); plant.add(particles);
        const resize = () => {
          if(!renderer || !stage) return;
          const w=Math.max(1,stage.clientWidth), h=Math.max(1,stage.clientHeight);
          camera.aspect=w/h; camera.updateProjectionMatrix(); renderer.setSize(w,h,false);
        };
        resizeObserver=new ResizeObserver(resize); resizeObserver.observe(stage); resize();
        observer=new IntersectionObserver(entries=>{ if(entries[0]?.isIntersecting) schedule(); else if(raf){cancelAnimationFrame(raf);raf=0;} },{threshold:.01});
        observer.observe(stage);
        stage.classList.add('ready');
        status.textContent = reduceMotion ? '3D bereit · Animation wegen Systemeinstellung pausiert' : '3D bereit · Bewege den Zeiger über die Szene';
        startTime=performance.now();
        function render(now){
          raf=0; if(disposed||paused||document.visibilityState!=='visible') return;
          const elapsed=(now-startTime)/1000;
          pointerX+=(targetX-pointerX)*.045; pointerY+=(targetY-pointerY)*.045;
          plant.rotation.x=pointerY+Math.sin(elapsed*.45)*.012;
          plant.rotation.y=pointerX+Math.sin(elapsed*.32)*.025;
          plant.position.y=Math.sin(elapsed*.8)*.025;
          leaves.forEach(({group,base,phase})=>{group.rotation.z=base+Math.sin(elapsed*.85+phase)*.025; group.rotation.x=Math.sin(elapsed*.55+phase)*.018;});
          particles.rotation.y=elapsed*.018; ring.rotation.z=elapsed*.018;
          renderer.render(scene,camera); schedule();
        }
        stage.addEventListener('pointermove',e=>{ if(reduceMotion) return; const r=stage.getBoundingClientRect(); targetX=((e.clientX-r.left)/r.width-.5)*.15; targetY=((e.clientY-r.top)/r.height-.5)*-.09; },{passive:true});
        stage.addEventListener('pointerleave',()=>{targetX=0;targetY=0;},{passive:true});
        document.addEventListener('visibilitychange',()=>{ if(document.visibilityState==='visible') schedule(); else if(raf){cancelAnimationFrame(raf);raf=0;} });
        motionButton.addEventListener('click',()=>{
          if(reduceMotion) return;
          paused=!paused; motionButton.setAttribute('aria-pressed',String(paused));
          motionButton.textContent=paused?'Animation fortsetzen':'Animation pausieren';
          status.textContent=paused?'Animation pausiert.':'Animation läuft.';
          if(!paused) schedule();
        });
        resetButton.addEventListener('click',()=>{targetX=0;targetY=0;pointerX=0;pointerY=0;plant.rotation.set(0,0,0);status.textContent='Ansicht zurückgesetzt.';schedule();});
        window.addEventListener('pagehide',dispose,{once:true});
        schedule();
      } catch (error) {
        console.warn('Botanical Lab 3D unavailable; static fallback retained.',error);
        status.textContent='3D nicht verfügbar · Fallback bleibt aktiv';
      }
    </script>
  </body>
</html>
