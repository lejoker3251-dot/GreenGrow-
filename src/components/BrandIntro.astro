    <path d="M222 347C169 324 128 279 112 225C165 231 207 273 222 347Z" stroke="currentColor" stroke-width="1.4"/>
    <path d="M222 347C169 324 128 279 112 225C165 231 207 273 222 347Z" fill="currentColor" fill-opacity=".07"/>
    <path d="M226 273C270 262 311 228 329 183C281 185 242 219 226 273Z" stroke="currentColor" stroke-width="1.4"/>
    <path d="M226 273C270 262 311 228 329 183C281 185 242 219 226 273Z" fill="currentColor" fill-opacity=".07"/>
    <path d="M235 205C204 174 192 133 202 91C235 117 248 160 235 205Z" stroke="currentColor" stroke-width="1.4"/>
    <path d="M235 205C204 174 192 133 202 91C235 117 248 160 235 205Z" fill="currentColor" fill-opacity=".07"/>
    <path d="M222 399C183 386 153 358 138 326M228 314C263 302 286 281 304 253M235 183C259 157 279 130 289 105" stroke="currentColor" stroke-opacity=".6"/>
