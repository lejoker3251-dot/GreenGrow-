---
---
<div class="botanical-scene" data-botanical-scene aria-hidden="true">
  <canvas class="botanical-canvas" data-botanical-canvas></canvas>
  <img class="hero-sculpture botanical-fallback" src="/products/botanical-luxury-hero.svg" alt="" width="900" height="860" fetchpriority="high" />
</div>

<style>
  .botanical-scene { position:absolute; inset:0; z-index:2; display:grid; place-items:center; pointer-events:none; perspective:1100px; }
  .botanical-canvas { position:absolute; inset:0; display:block; width:100%; height:100%; opacity:0; transition:opacity .8s ease; }
  .botanical-fallback { position:relative; z-index:1; width:min(112%,720px)!important; max-height:unset!important; transition:opacity .8s ease; }
  .botanical-scene.is-ready .botanical-canvas { opacity:1; }
  .botanical-scene.is-ready .botanical-fallback { opacity:.16; }
  @media(prefers-reduced-motion:reduce) { .botanical-canvas,.botanical-fallback { transition:none; } }
</style>

<script>
  const scenes = document.querySelectorAll<HTMLElement>('[data-botanical-scene]');
  scenes.forEach((root) => {
    const canvas = root.querySelector<HTMLCanvasElement>('[data-botanical-canvas]');
    const hero = root.closest<HTMLElement>('#hero-art');
    if (!canvas || !hero || !('WebGLRenderingContext' in window)) return;

    let renderer: any;
    let frame = 0;
    let visible = true;
    let disposed = false;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    // Keep the lightweight SVG fallback for reduced-motion and data-saving users.
    // Avoid downloading Three.js or creating a WebGL context when the user has opted out.
    if (reducedMotion || connection?.saveData) return;
    const clockStart = performance.now();
    let scene: any;
    let camera: any;
    let plant: any;
    let resizeObserver: ResizeObserver | undefined;
    let intersectionObserver: IntersectionObserver | undefined;
    let THREE: any;
    let updateScrollProgress: (() => void) | undefined;
    const rootMeshes: any[] = [];
    const leafMeshes: Array<{ mesh: any; base: any }> = [];
    const listeners: Array<{ target: EventTarget; type: string; listener: EventListener; options?: boolean | AddEventListenerOptions }> = [];
    let cleaned = false;
    const listen = (target: EventTarget, type: string, listener: EventListener, options?: boolean | AddEventListenerOptions) => {
      target.addEventListener(type, listener, options);
      listeners.push({ target, type, listener, options });
    };
    const cleanup = () => {
      if (cleaned) return;
      cleaned = true;
      disposed = true;
      if (frame) cancelAnimationFrame(frame);
      frame = 0;
      resizeObserver?.disconnect();
      intersectionObserver?.disconnect();
      listeners.forEach(({ target, type, listener, options }) => target.removeEventListener(type, listener, options));
      listeners.length = 0;
      const geometries = new Set<any>();
      const materials = new Set<any>();
      scene?.traverse?.((object: any) => {
        if (object.geometry) geometries.add(object.geometry);
        const objectMaterials = Array.isArray(object.material) ? object.material : object.material ? [object.material] : [];
        objectMaterials.forEach((material: any) => materials.add(material));
      });
      geometries.forEach((geometry) => geometry.dispose?.());
      materials.forEach((material) => material.dispose?.());
      renderer?.dispose?.();
      renderer = undefined;
      root.classList.remove('is-ready');
    };

    const makeTube = (points: any[], radius: number, material: any, radialSegments = 7, trackRoot = false) => {
      const curve = new THREE.CatmullRomCurve3(points.map((p) => new THREE.Vector3(p[0], p[1], p[2])));
      const geometry = new THREE.TubeGeometry(curve, Math.max(16, points.length * 8), radius, radialSegments, false);
      const meshMaterial = trackRoot ? material.clone() : material;
      const mesh = new THREE.Mesh(geometry, meshMaterial);
      plant.add(mesh);
      if (trackRoot) rootMeshes.push(mesh);
      return mesh;
    };

    const makeLeaf = (position: number[], scale: number[], rotation: number[], material: any) => {
      // Sculpted leaf silhouette instead of stretched spheres: a tapered outline,
      // subtle thickness, and a fine central vein create a more botanical finish.
      const outline = new THREE.Shape();
      outline.moveTo(-1, 0);
      outline.bezierCurveTo(-.62, .18, -.22, .43, .38, .29);
      outline.bezierCurveTo(.72, .17, .93, .06, 1, 0);
      outline.bezierCurveTo(.7, -.19, .23, -.38, -.34, -.26);
      outline.bezierCurveTo(-.66, -.18, -.88, -.06, -1, 0);
      const geometry = new THREE.ExtrudeGeometry(outline, {
        depth: .035,
        bevelEnabled: true,
        bevelSegments: 2,
        steps: 1,
        bevelSize: .012,
        bevelThickness: .01,
        curveSegments: 16
      });
      geometry.translate(0, 0, -.0175);
      const leaf = new THREE.Mesh(geometry, material);
      leaf.position.set(position[0], position[1], position[2]);
      leaf.scale.set(scale[0], scale[1], scale[2]);
      leaf.rotation.set(rotation[0], rotation[1], rotation[2]);
      plant.add(leaf);
      leafMeshes.push({ mesh: leaf, base: leaf.scale.clone() });

      const veinMaterial = new THREE.MeshStandardMaterial({ color: '#d6dfaa', roughness: .62, metalness: .02 });
      const veinPoints = [
        [-.88, 0, .025], [-.48, .015, .034], [-.08, .02, .04], [.34, .018, .04], [.88, 0, .025]
      ].map((point) => new THREE.Vector3(point[0], point[1], point[2]));
      const vein = new THREE.Mesh(
        new THREE.TubeGeometry(new THREE.CatmullRomCurve3(veinPoints), 28, .008, 5, false),
        veinMaterial
      );
      vein.position.copy(leaf.position);
      vein.scale.copy(leaf.scale);
      vein.rotation.copy(leaf.rotation);
      plant.add(vein);

      // Fine secondary veins follow the natural direction from the midrib to each edge.
      const veinGroup = new THREE.Group();
      const sideVeinMaterial = new THREE.MeshStandardMaterial({ color: '#d6dfaa', roughness: .68, transparent: true, opacity: .58 });
      [[-.52,.13,-.18,.25],[-.22,.19,.08,.31],[.12,.2,.42,.24],[.4,.13,.68,.14],
        [-.48,-.12,-.18,-.23],[-.18,-.19,.1,-.3],[.16,-.18,.44,-.22],[.43,-.1,.7,-.12]].forEach((v) => {
        const curve = new THREE.QuadraticBezierCurve3(
          new THREE.Vector3(v[0], v[1], .041),
          new THREE.Vector3((v[0] + v[2]) / 2, (v[1] + v[3]) / 2 + (v[1] > 0 ? .035 : -.035), .043),
          new THREE.Vector3(v[2], v[3], .035)
        );
        veinGroup.add(new THREE.Mesh(new THREE.TubeGeometry(curve, 8, .0035, 4, false), sideVeinMaterial));
      });
      veinGroup.position.copy(leaf.position);
      veinGroup.scale.copy(leaf.scale);
      veinGroup.rotation.copy(leaf.rotation);
      plant.add(veinGroup);
      return leaf;
    };

    const start = async () => {
      try {
        const url = 'https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js';
        THREE = await import(/* @vite-ignore */ url);
        if (disposed) return;
        scene = new THREE.Scene();
        camera = new THREE.PerspectiveCamera(32, 1, .1, 100);
        camera.position.set(0, .08, 8.5);
        renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: false, powerPreference: 'low-power' });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.5));
        renderer.setSize(Math.max(1, root.clientWidth), Math.max(1, root.clientHeight), false);
        renderer.outputColorSpace = THREE.SRGBColorSpace;
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.toneMappingExposure = 1.12;

        scene.add(new THREE.HemisphereLight('#f4f0d8', '#17251a', 2.0));
        const key = new THREE.DirectionalLight('#f2d9a0', 3.0);
        key.position.set(3, 4, 5);
        scene.add(key);
        const rim = new THREE.PointLight('#a9d49a', 16, 12);
        rim.position.set(-3, 1.4, -1);
        scene.add(rim);

        plant = new THREE.Group();
        scene.add(plant);
        const stemMat = new THREE.MeshStandardMaterial({ color: '#78945d', roughness: .68, metalness: .02 });
        const rootMat = new THREE.MeshStandardMaterial({ color: '#b9a47a', roughness: .82 });
        const leafMat = new THREE.MeshStandardMaterial({ color: '#789a5a', roughness: .42, metalness: .02, side: THREE.DoubleSide });
        const leafLight = new THREE.MeshStandardMaterial({ color: '#a9bf78', roughness: .44, side: THREE.DoubleSide });
        const soilMat = new THREE.MeshPhysicalMaterial({ color: '#9e8358', roughness: .55, metalness: .04, transparent: true, opacity: .18, side: THREE.DoubleSide });
        const shellMat = new THREE.MeshBasicMaterial({ color: '#d5d0a4', transparent: true, opacity: .22, wireframe: true });

        const orb = new THREE.Mesh(new THREE.SphereGeometry(1.45, 28, 20), soilMat);
        orb.position.set(0, -.42, -.18);
        plant.add(orb);
        const shell = new THREE.Mesh(new THREE.SphereGeometry(1.49, 24, 18), shellMat);
        shell.position.copy(orb.position);
        plant.add(shell);

        // A dormant seed sits beneath the surface at the beginning of the story.
        const seed = new THREE.Mesh(
          new THREE.SphereGeometry(1, 20, 14),
          new THREE.MeshStandardMaterial({ color: '#b9a16b', roughness: .5, metalness: .02 })
        );
        seed.position.set(0, -.48, .42);
        seed.scale.set(.14, .2, .12);
        seed.rotation.z = -.3;
        plant.add(seed);

        makeTube([[0,-.38,0],[.02,-.05,.02],[-.03,.35,.03],[.04,.7,.02],[.02,1.05,0],[.06,1.42,0],[.02,1.68,0]], .035, stemMat, 8);
        makeTube([[0,-.32,.02],[-.05,-.6,.05],[-.12,-.88,.08],[-.2,-1.18,.1],[-.18,-1.43,.08]], .018, rootMat, 7, true);
        makeTube([[0,-.35,.02],[.12,-.62,.02],[.25,-.88,.02],[.4,-1.1,.02],[.48,-1.34,.03]], .016, rootMat, 7, true);
        makeTube([[-.05,-.68,.05],[-.28,-.83,.07],[-.44,-1.02,.09],[-.58,-1.16,.09]], .009, rootMat, 5, true);
        makeTube([[.22,-.83,.02],[.12,-1.02,.03],[.1,-1.22,.02]], .009, rootMat, 5, true);
        makeTube([[.39,-1.08,.02],[.62,-1.13,.04],[.72,-1.27,.02]], .008, rootMat, 5, true);
        makeTube([[-.16,-1.1,.08],[-.1,-1.23,.1],[-.13,-1.36,.12]], .008, rootMat, 5, true);

        makeLeaf([-.34,.86,.03],[.53,.2,.1],[0,0,-.48],leafMat);
        makeLeaf([.36,1.12,.03],[.55,.21,.1],[0,0,.48],leafLight);
        makeLeaf([-.22,1.43,.02],[.42,.17,.09],[0,0,-.62],leafLight);
        makeLeaf([.23,1.62,.02],[.38,.16,.08],[0,0,.5],leafMat);
        makeLeaf([.01,1.87,0],[.22,.31,.09],[0,0,-.08],leafLight);

        const ringMat = new THREE.MeshBasicMaterial({ color: '#d0c69a', transparent: true, opacity: .34 });
        const ring = new THREE.Mesh(new THREE.TorusGeometry(1.72, .008, 5, 100), ringMat);
        ring.position.set(0,-.35,-.4);
        ring.rotation.x = Math.PI * .36;
        plant.add(ring);

        const particleCount = 32;
        const particlePositions = new Float32Array(particleCount * 3);
        for (let i = 0; i < particleCount; i++) {
          const angle = i * 2.399;
          const radius = .7 + (i % 7) * .17;
          particlePositions[i*3] = Math.cos(angle) * radius;
          particlePositions[i*3+1] = -1.1 + ((i * 13) % 31) / 10;
          particlePositions[i*3+2] = -.4 + Math.sin(angle) * .6;
        }
        const particleGeometry = new THREE.BufferGeometry();
        particleGeometry.setAttribute('position', new THREE.BufferAttribute(particlePositions, 3));
        const particles = new THREE.Points(particleGeometry, new THREE.PointsMaterial({ color: '#e0d9ae', size: .028, transparent: true, opacity: .7, sizeAttenuation: true }));
        plant.add(particles);

        const resize = () => {
          const width = Math.max(1, root.clientWidth);
          const height = Math.max(1, root.clientHeight);
          camera.aspect = width / height;
          camera.updateProjectionMatrix();
          renderer.setSize(width, height, false);
        };
        resizeObserver = new ResizeObserver(resize);
        resizeObserver.observe(root);
        intersectionObserver = new IntersectionObserver((entries) => {
          visible = Boolean(entries[0]?.isIntersecting);
          if (visible && !reducedMotion) schedule();
        }, { threshold: 0.01 });
        intersectionObserver.observe(root);

        let pointerX = 0;
        let pointerY = 0;
        let targetX = 0;
        let targetY = 0;
        let scrollProgress = reducedMotion ? 1 : 0;
        let targetScrollProgress = reducedMotion ? 1 : 0;
        updateScrollProgress = () => {
          if (reducedMotion) return;
          const heroTop = hero.getBoundingClientRect().top + window.scrollY;
          const travel = Math.max(1, hero.offsetHeight * .85);
          targetScrollProgress = Math.max(0, Math.min(1, (window.scrollY - heroTop + window.innerHeight * .08) / travel));
          schedule();
        };
        listen(window, 'scroll', updateScrollProgress as EventListener, { passive: true });
        if (finePointer && !reducedMotion) {
          listen(hero, 'pointermove', ((event: PointerEvent) => {
            const rect = hero.getBoundingClientRect();
            if (!rect.width || !rect.height) return;
            targetY = ((event.clientX - rect.left) / rect.width - .5) * .18;
            targetX = ((event.clientY - rect.top) / rect.height - .5) * -.1;
          }) as EventListener, { passive: true });
          listen(hero, 'pointerleave', (() => { targetX = 0; targetY = 0; }) as EventListener, { passive: true });
        }

        root.classList.add('is-ready');
        let lastFrame = 0;
        const render = (now: number) => {
          frame = 0;
          if (disposed || !renderer || !visible) return;
          if (now - lastFrame < 32) { schedule(); return; }
          const elapsed = (now - clockStart) / 1000;
          const t = reducedMotion ? 0 : elapsed;
          pointerX += (targetX - pointerX) * .045;
          pointerY += (targetY - pointerY) * .045;
          scrollProgress += (targetScrollProgress - scrollProgress) * .055;
          // Scroll reveals the botanical story in stages: seed, roots, then leaves.
          const seedReveal = Math.max(0, 1 - scrollProgress * 3.4);
          const rootReveal = Math.max(.035, Math.min(1, (scrollProgress - .08) * 3.2));
          const leafReveal = Math.max(.08, Math.min(1, (scrollProgress - .34) * 2.4));
          seed.scale.set(.14 * seedReveal, .2 * seedReveal, .12 * seedReveal);
          seed.material.opacity = Math.max(.12, seedReveal);
          seed.material.transparent = true;
          rootMeshes.forEach((rootMesh, index) => {
            const stagger = Math.min(1, rootReveal * (1.12 - index * .025));
            rootMesh.scale.set(stagger, stagger, stagger);
            rootMesh.material.transparent = true;
            rootMesh.material.opacity = .18 + stagger * .82;
          });
          leafMeshes.forEach(({ mesh, base }, index) => {
            const stagger = Math.max(.06, Math.min(1, leafReveal * (1.12 - index * .035)));
            mesh.scale.set(base.x * stagger, base.y * stagger, base.z * stagger);
          });
          // A restrained scroll-linked camera move gives the plant a sense of depth
          // without hijacking native iPad scrolling or changing the page layout.
          const growthScale = 1 + scrollProgress * .075;
          plant.scale.setScalar(growthScale);
          camera.position.z = 8.5 - scrollProgress * .28;
          camera.position.y = .08 + scrollProgress * .06;
          camera.lookAt(0, .12, 0);
          plant.rotation.x = pointerX + (reducedMotion ? 0 : Math.sin(t * .45) * .018);
          plant.rotation.y = pointerY + scrollProgress * .09 + (reducedMotion ? 0 : Math.sin(t * .32) * .035);
          plant.position.y = reducedMotion ? 0 : Math.sin(t * .8) * .035 + scrollProgress * .035;
          particles.rotation.y = reducedMotion ? 0 : t * .025 + scrollProgress * .04;
          ring.rotation.z = reducedMotion ? 0 : t * .025 + scrollProgress * .06;
          renderer.render(scene, camera);
          lastFrame = now;
          if (!reducedMotion) schedule();
        };
        const schedule = () => { if (!frame && visible && !disposed) frame = requestAnimationFrame(render); };
        updateScrollProgress();
        schedule();
      } catch (error) {
        cleanup();
        console.warn('GreenGrow 3D scene unavailable; keeping botanical fallback.', error);
      }
    };

    start();
    window.addEventListener('pagehide', cleanup, { once: true });
  });
</script>
