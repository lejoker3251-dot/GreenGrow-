---
import '../styles/design-tokens.css';
import '../styles.css';
import '../styles/botanical-motion.css';
const { title = 'SEED³X – Saatgut und botanische Inspiration', description = 'SEED³X verbindet Saatgut, botanische Inspiration und einen bewussten Blick auf Wachstum.' } = Astro.props;
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#173f2a" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      (function () {
        var path = window.location.pathname;
        var onNoticePage = path.indexOf('/altershinweis') === 0;
        try {
          if (!onNoticePage && localStorage.getItem('seedx-age-confirmed') !== 'true') {
            document.documentElement.classList.add('age-gate-active');
          }
        } catch (e) {
          if (!onNoticePage) document.documentElement.classList.add('age-gate-active');
        }
      })();
    </script>
  </head>
  <body>
    <div id="age-gate" class="age-gate" role="dialog" aria-modal="true" aria-labelledby="age-gate-title" aria-describedby="age-gate-desc">
      <div class="age-gate-card">
        <span class="eyebrow">SEED³X · ALTERSBESTÄTIGUNG</span>
        <h2 id="age-gate-title">Bist du mindestens 18 Jahre alt?</h2>
        <p id="age-gate-desc">SEED³X informiert über Vermehrungsmaterial (Samen) im Rahmen des Konsumcannabisgesetzes (KCanG). Das Angebot richtet sich ausschließlich an Erwachsene.</p>
        <div class="age-gate-actions">
          <button type="button" id="age-gate-yes" class="button">Ja, ich bin 18 oder älter</button>
          <button type="button" id="age-gate-no" class="button secondary">Nein</button>
        </div>
      </div>
    </div>
    <a class="skip-link" href="#main-content">Zum Inhalt springen</a>
    <header class="site-header">
      <a class="brand brand-seedx" href="/" aria-label="SEED³X Startseite"><img class="brand-banner" src="/images/seedx-banner.png.PNG" alt="SEED³X – Grow with intention" width="760" height="220" /></a>
      <button class="menu-toggle" type="button" aria-label="Menü öffnen" aria-expanded="false" aria-controls="main-nav"><span class="menu-toggle-label">Menü</span><span class="menu-toggle-icon" aria-hidden="true">☰</span></button>
      <nav id="main-nav" class="main-nav" aria-label="Hauptnavigation" hidden>
        <a href="/" aria-current={currentPath === '/' ? 'page' : undefined}>Startseite</a>
        <div class="nav-group" data-nav-group="shop">
          <button class="nav-group-toggle" type="button" aria-expanded="false" aria-controls="shop-submenu" aria-current={currentPath.startsWith('/shop') || currentPath.startsWith('/product/') || currentPath.startsWith('/shopping-cart') ? 'location' : undefined}>
            Shop <span class="nav-chevron" aria-hidden="true">⌄</span>
          </button>
          <div id="shop-submenu" class="nav-submenu" hidden>
            <a href="/shop/" aria-current={currentPath.startsWith('/shop') ? 'page' : undefined}>Gesamtes Sortiment</a>
            <a href="/shopping-cart/" aria-current={currentPath.startsWith('/shopping-cart') ? 'page' : undefined}>Merkliste <span id="cart-count" class="cart-count">0</span></a>
          </div>
        </div>
        <a href="/wissen/" aria-current={currentPath.startsWith('/wissen') ? 'page' : undefined}>Wissen & Ratgeber</a>
        <a href="/#wachstumsreise">Unsere Idee</a>
        <a href="/#ueber-greengrow">Über uns</a>
        <a href="mailto:hallo@greengrow.example">Kontakt</a>
      </nav>
    </header>
    <main id="main-content" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <p>SEED³X – Saatgut und botanische Inspiration für neue Wachstumsräume.</p>
      <div class="footer-links"><a href="/shop/">Shop</a><a href="/wissen/">Wissen</a><a href="/#wachstumsreise">Unsere Idee</a><a href="/#ueber-greengrow">Über uns</a><a href="mailto:hallo@greengrow.example">Kontakt (Platzhalter)</a><a href="/shopping-cart/">Merkliste</a><a href="/impressum/">Impressum</a><a href="/datenschutz/">Datenschutz</a></div>
      <small>© {new Date().getFullYear()} SEED³X · Impressum und Datenschutz sind Entwürfe und müssen vor Veröffentlichung mit echten, geprüften Daten ergänzt werden.</small>
    </footer>
    <script is:inline>
      const menuButton = document.querySelector('.menu-toggle');
      const nav = document.querySelector('#main-nav');

      const setMenuOpen = (open) => {
        menuButton?.setAttribute('aria-expanded', String(open));
        menuButton?.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
        const menuLabel = menuButton?.querySelector('.menu-toggle-label');
        if (menuLabel) menuLabel.textContent = open ? 'Schließen' : 'Menü';
        const menuIcon = menuButton?.querySelector('.menu-toggle-icon');
        if (menuIcon) menuIcon.textContent = open ? '×' : '☰';
        if (nav) nav.hidden = !open;
        nav?.classList.toggle('is-open', open);
        if (!open) {
          const submenu = nav?.querySelector('#shop-submenu');
          const submenuToggle = nav?.querySelector('.nav-group-toggle');
          if (submenu) submenu.hidden = true;
          submenuToggle?.setAttribute('aria-expanded', 'false');
          nav?.querySelector('[data-nav-group="shop"]')?.classList.remove('is-open');
        }
      };

      menuButton?.addEventListener('click', () => {
        const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
        setMenuOpen(!isOpen);
      });

      nav?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setMenuOpen(false));
      });

      const shopGroup = nav?.querySelector('[data-nav-group="shop"]');
      const shopToggle = shopGroup?.querySelector('.nav-group-toggle');
      const shopSubmenu = shopGroup?.querySelector('#shop-submenu');
      const setShopSubmenuOpen = (open) => {
        shopToggle?.setAttribute('aria-expanded', String(open));
        if (shopSubmenu) shopSubmenu.hidden = !open;
        shopGroup?.classList.toggle('is-open', open);
      };

      shopToggle?.addEventListener('click', () => {
        const isOpen = shopToggle.getAttribute('aria-expanded') === 'true';
        setShopSubmenuOpen(!isOpen);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && shopToggle?.getAttribute('aria-expanded') === 'true') {
          setShopSubmenuOpen(false);
          shopToggle.focus();
        }
      });

      document.addEventListener('click', (event) => {
        if (shopToggle?.getAttribute('aria-expanded') !== 'true') return;
        if (event.target instanceof Node && !shopGroup?.contains(event.target)) {
          setShopSubmenuOpen(false);
        }
      });

      document.addEventListener('click', (event) => {
        if (menuButton?.getAttribute('aria-expanded') !== 'true') return;
        if (event.target instanceof Node && !menuButton?.contains(event.target) && !nav?.contains(event.target)) {
          setMenuOpen(false);
        }
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menuButton?.getAttribute('aria-expanded') === 'true') {
          setMenuOpen(false);
          menuButton.focus();
        }
      });

      try {
        const saved = JSON.parse(localStorage.getItem('greengrow-list') || '[]');
        const count = document.querySelector('#cart-count');
        if (count) count.textContent = String(Array.isArray(saved) ? saved.length : 0);
      } catch {}

      const ageGate = document.querySelector('#age-gate');
      const ageGateYes = document.querySelector('#age-gate-yes');
      const ageGateNo = document.querySelector('#age-gate-no');
      const pageRegions = [
        document.querySelector('.site-header'),
        document.querySelector('#main-content'),
        document.querySelector('.site-footer')
      ].filter(Boolean);
      const isAgeGateActive = () => document.documentElement.classList.contains('age-gate-active');

      const syncAgeGateAccess = (active) => {
        pageRegions.forEach((region) => {
          region.inert = active;
        });
      };

      syncAgeGateAccess(isAgeGateActive());
      if (isAgeGateActive()) ageGateYes?.focus();

      ageGateYes?.addEventListener('click', () => {
        try {
          localStorage.setItem('seedx-age-confirmed', 'true');
        } catch {}
        document.documentElement.classList.remove('age-gate-active');
        syncAgeGateAccess(false);
        document.querySelector('#main-content')?.focus();
      });
      ageGateNo?.addEventListener('click', () => {
        window.location.href = '/altershinweis/';
      });

      ageGate?.addEventListener('keydown', (event) => {
        if (event.key !== 'Tab') return;
        const focusable = Array.from(ageGate.querySelectorAll('button:not([disabled]), a[href], input:not([disabled]), [tabindex]:not([tabindex="-1"])'));
        if (!focusable.length) {
          event.preventDefault();
          return;
        }
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      });

      document.addEventListener('focusin', (event) => {
        if (isAgeGateActive() && ageGate && !ageGate.contains(event.target)) {
          ageGateYes?.focus();
        }
      });
    </script>
    <style>
      .age-gate{display:none;position:fixed;inset:0;z-index:999;align-items:center;justify-content:center;padding:1.5rem;background:rgba(10,20,12,.92)}
      :global(html.age-gate-active) .age-gate{display:flex}
      :global(html.age-gate-active) body{overflow:hidden}
      .age-gate-card{max-width:440px;width:100%;background:#fffaf0;border-radius:20px;padding:clamp(1.8rem,4vw,2.4rem);text-align:center;box-shadow:0 30px 60px rgba(0,0,0,.35)}
      .age-gate-card h2{font-family:Georgia,serif;font-weight:500;margin:.6rem 0 1rem;font-size:1.5rem}
      .age-gate-card p{color:var(--muted);line-height:1.7;margin:0 0 1.6rem}
      .age-gate-actions{display:flex;gap:.8rem;justify-content:center;flex-wrap:wrap}
    </style>
  </body>
</html>
