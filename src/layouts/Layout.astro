---
import '../styles.css';
import '../styles/botanical-motion.css';
const { title = 'SEED³X – Saatgut und botanische Inspiration', description = 'SEED³X verbindet Saatgut, botanische Inspiration und einen bewussten Blick auf Wachstum.' } = Astro.props;
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#173f2a" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Zum Inhalt springen</a>
    <header class="site-header">
      <a class="brand brand-seedx" href="/" aria-label="SEED³X Startseite"><img class="brand-banner" src="/images/seedx-banner.png.PNG" alt="SEED³X – Grow with intention" width="760" height="220" /></a>
      <button class="menu-toggle" type="button" aria-label="Menü öffnen" aria-expanded="false" aria-controls="main-nav">Menü <span aria-hidden="true">☰</span></button>
      <nav id="main-nav" class="main-nav" aria-label="Hauptnavigation">
        <a href="/shop/" aria-current={currentPath.startsWith('/shop') ? 'page' : undefined}>Shop</a><a href="/wissen/" aria-current={currentPath.startsWith('/wissen') ? 'page' : undefined}>Wissen</a><a href="/#wachstumsreise">Unsere Idee</a><a href="/#ueber-greengrow">Über uns</a>
      </nav>
      <a class="cart-link" href="/shopping-cart/" aria-label="Merkliste öffnen">Merkliste <span id="cart-count" class="cart-count">0</span></a>
    </header>
    <main id="main-content" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <p>SEED³X – Saatgut und botanische Inspiration für neue Wachstumsräume.</p>
      <div class="footer-links"><a href="/shop/">Shop</a><a href="/wissen/">Wissen</a><a href="/#wachstumsreise">Unsere Idee</a><a href="/#ueber-greengrow">Über uns</a><a href="mailto:hallo@greengrow.example">Kontakt (Platzhalter)</a><a href="/shopping-cart/">Merkliste</a></div>
      <small>© {new Date().getFullYear()} SEED³X · Vor Veröffentlichung Impressum, Datenschutz und Kontaktdaten ergänzen.</small>
    </footer>
    <script is:inline>
      const menuButton = document.querySelector('.menu-toggle');
      const nav = document.querySelector('#main-nav');

      const setMenuOpen = (open) => {
        menuButton?.setAttribute('aria-expanded', String(open));
        menuButton?.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
        nav?.classList.toggle('is-open', open);
      };

      menuButton?.addEventListener('click', () => {
        const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
        setMenuOpen(!isOpen);
      });

      nav?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setMenuOpen(false));
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menuButton?.getAttribute('aria-expanded') === 'true') {
          setMenuOpen(false);
          menuButton.focus();
        }
      });

      try {
        const saved = JSON.parse(localStorage.getItem('greengrow-list') || '[]');
        const count = document.querySelector('#cart-count');
        if (count) count.textContent = String(Array.isArray(saved) ? saved.length : 0);
      } catch {}
    </script>
  </body>
</html>
