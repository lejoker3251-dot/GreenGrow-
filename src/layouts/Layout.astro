---
import '../styles.css';
import '../styles/botanical-motion.css';
const { title = 'GreenGrow Seeds – Saatgut für deinen Garten', description = 'Entdecke Saatgut für Balkon, Beet und Garten mit GreenGrow Seeds.' } = Astro.props;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#173f2a" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="announcement">Kleine Samen. Große Ideen. Willkommen bei GreenGrow Seeds.</div>
    <header class="site-header">
      <a class="brand" href="/" aria-label="GreenGrow Seeds Startseite"><span class="brand-mark">✳</span><span>GreenGrow <small>SEEDS</small></span></a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">Menü <span aria-hidden="true">☰</span></button>
      <nav id="main-nav" class="main-nav" aria-label="Hauptnavigation">
        <a href="/#sortiment">Sortiment</a><a href="/#neuheiten">Neuheiten</a><a href="/#bestseller">Bestseller</a><a href="/#ratgeber">Ratgeber</a><a href="/#ueber-greengrow">Über GreenGrow</a>
      </nav>
      <a class="cart-link" href="/shopping-cart/" aria-label="Merkliste öffnen">Merkliste <span id="cart-count" class="cart-count">0</span></a>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <a class="brand brand-footer" href="/"><span class="brand-mark">✳</span><span>GreenGrow <small>SEEDS</small></span></a>
      <p>Saatgut für mehr Grün, mehr Geschmack und mehr Freude am Wachsen.</p>
      <div class="footer-links"><a href="/#sortiment">Sortiment</a><a href="/#neuheiten">Neuheiten</a><a href="/#ratgeber">Ratgeber</a><a href="/#ueber-greengrow">Über GreenGrow</a><a href="mailto:hallo@greengrow.example">Kontakt (Platzhalter)</a><a href="/shopping-cart/">Merkliste</a></div>
      <small>© {new Date().getFullYear()} GreenGrow Seeds · Vor Veröffentlichung Impressum, Datenschutz und Kontaktdaten ergänzen.</small>
    </footer>
    <script is:inline>
      const menuButton = document.querySelector('.menu-toggle');
      const nav = document.querySelector('#main-nav');
      menuButton?.addEventListener('click', () => {
        const open = menuButton.getAttribute('aria-expanded') === 'true';
        menuButton.setAttribute('aria-expanded', String(!open));
        nav?.classList.toggle('is-open', !open);
      });
      try {
        const saved = JSON.parse(localStorage.getItem('greengrow-list') || '[]');
        const count = document.querySelector('#cart-count');
        if (count) count.textContent = String(saved.length);
      } catch {}
    </script>
  </body>
</html>
