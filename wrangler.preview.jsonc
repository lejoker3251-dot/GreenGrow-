{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "greengrow-preview",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": false,
    "html_handling": "auto-trailing-slash"
  }
}
